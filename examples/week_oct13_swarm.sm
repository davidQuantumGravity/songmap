# The Swarm (2:03), faithful v0.2 port of the original Oct-13 track. Compact form.
# Same notes as examples/v0.2_yaml/week_oct13_swarm.songmap.yaml (tests/test_lang.py checks the digest).
song "Week of Oct 13 — The Swarm" 120 4/4 Em fps=30 mood=techno tail=3 seed=7 video=WeekSwarm:3690
inst bass(cutoff=700)
chords Em C G D /2
master legacy
motif m1 deg oct=5 "0 -3 0 2 | 1/2 0"
motif m2 deg oct=5 "-2 -3 -2 0 | -1/2. -3/4"
motif m3 deg oct=5 "2 0 2 4 | 3/2 2"
motif m4 deg oct=5 "1/4. 0/8 -1/2 | -3/1"
lit = up(order=[0, 2, 1, 3, 0, 2, 4, 3, 1, 2, 0, 3])
dim = dark(order=[0, 2, 1, 3, 0, 2, 4, 3, 1, 2, 0, 3])
lift = !impact !riser:2 !riser:1@+8
# name    bars | parts                                              | events
terminal    4 | arp:dim fx:ticks bass:sub
swarm_in    4 | drums:four_floor bass:8ths arp:dim fx:ticks           | !impact
goals       8 | drums:full+fill bass:8ths arp:lit pad:warm            | !riser:1
who         2 | pad:dark fx:ticks
agents     16 | like=goals drums:full+fill+open lead:m1,m2,m3,m4      | !lift
so_what     2 | pad:warm arp:dim fx:ticks bass:sub
output     16 | like=agents drums:full+fill+hats16+open fx:ticks       | !lift
guardrails  4 | pad:warm arp:dim bass:sub
summary     2 | pad:warm arp:lit                                      | !impact
end_card    2 | pad:dark                                              | !impact
qa lufs=-14 contrast=who<agents:6,so_what<output:6
