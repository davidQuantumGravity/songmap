# The Swarm (2:03), faithful v0.2 port of the original Oct-13 track. Compact form.
song "Week of Oct 13 — The Swarm" 120 4/4 Em fps=30 mood=techno tail=3 seed=7 video=WeekSwarm:3690
inst kick=kick/punchy bass=bass(cutoff=700) arp=pluck pad=pad lead=lead
groove swing=.5 hum=3,2,.03
chords Em C G D /2
motif m1 deg oct=5 "0 -3 0 2 | 1/2 0"
motif m2 deg oct=5 "-2 -3 -2 0 | -1/2. -3/4"
motif m3 deg oct=5 "2 0 2 4 | 3/2 2"
motif m4 deg oct=5 "1/4. 0/8 -1/2 | -3/1"
