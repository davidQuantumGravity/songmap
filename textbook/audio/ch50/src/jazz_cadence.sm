# The golden jazz cadence (ch29, ch50): ii7 - V7 - Imaj7 in C, plain, then Dm7 - Dg7 - vGg/D - G7 - Baug(v3)/G -
# ^Ebg(^5)/G - Cmaj7, the golden chords on the weak halves.
song "Golden jazz cadence" 120 4/4 C fps=30 seed=1301 tail=3 tuning=36edo
inst epiano=epiano/still horn=clean/organ(partials=7, rolloff=1.5, even=.6, attack=.035, release=.18, vel_bright=.8)
kit kick=kick/v0(tune=55, sweep=26, decay=.28, click=.65, click_tone=4500, drive=2) snare=snare/v0(tone=205, tone_mix=.5, snap=.65, noise_decay=.2, drive=1.5) hat=hat/v0(decay=.045) ride=hat/v0(decay=.3, hp=3500, color=6500, metal=.85, tune=.8) cym=hat/v0_open(decay=1.4, hp=3200, metal=.75)
plain   4 | epiano:hold(voices=4, range=[52,72]) bass:bassline drums:{ride: {steps: "x..x.xx..x.x", vel: [0.4, 0.25, 0.18, 0.35, 0.25, 0.18]}} chords="Dm7:1 G7:1 Cmaj7:2" dyn=mp
golden  4 | like=plain chords="Dm7:1 Dg7:0.5 vGg/D:0.5 G7:0.5 Baug(v3)/G:0.25 ^Ebg(^5)/G:0.25 Cmaj7:1"
mix epiano -8 hall=.2 | bass -8 | drums -8
master standard lufs=-14 glue=none
