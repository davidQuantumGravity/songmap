# The door (ch50): the golden pedal walk Cg - ^Abg - vFg - ^Abg over a held C, then Cg bends into C (vE rises to E,
# ^G falls to G: the golden projection reversed), and the 7/8 riff in C phrygian dominant starts on that C.
song "The golden door" 72 4/4 C fps=30 seed=1301 tail=2 tuning=36edo
patch axe str=string(t60=1.6, brightness=.93, pick=.003) sh=shaper(drive=.8) cab=filter(mode=lp, cutoff=4200, q=1.2, keytrack=0) env=env(a=.002, d=.4, s=.85, r=.07) amp=vca out=out(level=.6)
patch axe str>sh sh>cab cab>amp env>amp.gain amp>out vel>sh.drive*.3
inst axe=patch/axe bass=bass/v0(cutoff=850, drive=2.2, env_amt=1.6, env_decay=.12, sub=.4, glide=.03) gold=clean/golden_pad(release=2) gtr=string_pluck/still(brightness=.8, t60=2.4) low=clean/bass bell=clean/glass
kit kick=kick/v0(tune=55, sweep=26, decay=.28, click=.65, click_tone=4500, drive=2) snare=snare/v0(tone=205, tone_mix=.5, snap=.65, noise_decay=.2, drive=1.5) hat=hat/v0(decay=.045) ride=hat/v0(decay=.3, hp=3500, color=6500, metal=.85, tune=.8) cym=hat/v0_open(decay=1.4, hp=3200, metal=.75)
riff = {deg: "=f 0/16^ 0 r 0 1/8^ 0/16 r 0 0 4/8^ 3/16 1 | 0/16^ 0 r 0 1/8^ 0/16 r -1 -2 -3/8^ -2/16 -1 | 0/16^ 0 r 0 1/8^ 0/16 r 0 0 4/8^ 5/16 4 | 7/8^ 6/16 5 4/8 3/16 1 0/8^ 0/16 r 0 r", oct: -2}
ripple = {rel: "R/8 5 3+ 5 R+ 5 3+ 5", oct: -1}
pedal    4 | gold:hold gtr:ripple low:{notes: "=p c1", oct: -2} chords="Cg:1 ^Abg:1 vFg:1 ^Abg:1" dyn=p<mp
bend     2 | gold:hold gtr:ripple low:{notes: "=mp c1", oct: -2} bell:{deg: "=mp 0/1 | 0/1", oct: 1} chords="Cg:1 C:1" dyn=mp | !riser:2@+2
riffing  4 | axe:riff bass:{deg: "=f 0/16^ 0 r 0 1/8^ 0/16 r 0 0 4/8^ 3/16 1 | 0/16^ 0 r 0 1/8^ 0/16 r -1 -2 -3/8^ -2/16 -1 | 0/16^ 0 r 0 1/8^ 0/16 r 0 0 4/8^ 5/16 4 | 7/8^ 6/16 5 4/8 3/16 1 0/8^ 0/16 r 0 r", oct: -2} drums:{kick: "XX.X..X.XX....|XX.X..X.XX....|XX.X..X.XX....|X.....X.X.X.X.", snare: "....X.....X...", hat: "x.x.x.x.x.x.x.", cym: "X.............|..............|..............|.............."} chords="C:1" key="C phrygian_dominant" meter="7/8 2+2+3" tempo=138 dyn=f | !impact
mix axe -6 | bass -8 | gold -9 hall=.35 | gtr -3 hall=.3 | low 0 | bell -8 hall=.4 | drums -4 | fx -6
master standard lufs=-14 glue=none
