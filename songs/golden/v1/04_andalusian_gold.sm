# 4. Andalusian Gold (1:40). A minor / E Phrygian, 100 BPM, flamenco-tinged. The same cadence, plain then golden.
# Technique (docs/GOLDEN_THEORY.md §4.2, golden Andalusian): the descent Am - G - F - E with golden chords
# in its gaps, Am -> Abg -> vAbg -> G -> ^F#g -> vF#g -> F (System 2, ~g ~g), and the last half step
# taken by planing, F -> vF -> ^E -> E, because no golden chord joins chords a half step apart
# (the half-step theorem). Under it the bass walks down the whole tetrachord in sixth-steps:
# A - Ab - vAb - G - ^F# - vF# - F - vF - ^E - E.
# Form: the plain Western cadence first, so the ear knows it; then the golden one, where the voice sings
# two beats and the guitar answers in gold; a falseta in the relative major; the golden cadence at full
# strength; and a flamenco ending that hangs on E.
song "Andalusian Gold" 100 4/4 Am fps=30 seed=24 tail=4 tuning=36edo
inst gtr=string_pluck/still(brightness=.8) lead=clean/lead bell=clean/glass

prog plain  "Am:1 G:1 F:1 E:1"
prog golden "Am:0.5 ~g:0.25 ~g:0.25 G:0.5 ~g:0.25 ~g:0.25 F:0.5 vF:0.25 ^E:0.25 E:1"
prog falseta "Dm:0.75 ~:0.25 Am:1 Dm:0.75 ~:0.25 Am:1 F:1 G:1 F:0.5 vF:0.25 ^E:0.25 E:1"

# Strums on beats 1, 2, 2&, 3&, 4: the 3& and 4 strums land on the golden chords.
strum = {rel: "[R,5,R+,3+]/4 [R,5,R+,3+]/8 [R,5,R+,3+] r/8 [R,5,R+,3+] [R,5,R+,3+]/4"}
walk = {rel: "R/4 R R R", oct: -2}                    # a root on every beat: the descent in sixth-steps
palmas = {kick: "X.......x.......", clap: {steps: "X..x..x...x.x...", vel: [0.9, 0.55, 0.7, 0.55, 0.65]}, hat: {steps: "-.-.-.-.-.-.-.-.", vel: [0.3]}}

# deg 0 = A4 (A minor); over E the melody uses G# (#6) and the Phrygian F -> E grace.
cante = "=mf 4/4. 5/8 4/4 2 | 1/4. 2/8 1/2 | 0/4 1/8 0 -2/2 | {-2}-3/1 | 7/4. 8/8 7/4 5 | 6/4. 7/8 6/2 | 5/4 6/8 5 3/2 | {5}4/1"
answer = "=f 4/4. 5/8 r/2 | 1/4. 2/8 r/2 | 0/4 1/8 0 r/2 | {-2}-3/1 | 7/4. 8/8 r/2 | 6/4. 7/8 r/2 | 5/4 6/8 5 r/2 | {5}4/1"
falseta = "=mp 3/4 2 0/4 r/4 | 0/2 2/4 4 | 5/4 4 3/4 r/4 | 2/1 | 0/4 2 0 -2 | 1/4 -1 1 2 | 0/4 -2/4 r/2 | {-2}-3/1"

# name    bars | parts and settings                                                | events
intro       4 | gtr:strum prog=plain dyn=p<mf
plain       8 | gtr:strum bass:walk drums:palmas lead:{deg: cante} prog=plain dyn=mp
gold        8 | like=plain lead:{deg: answer} prog=golden dyn=mf                  | !impact(size=s)
falseta     8 | gtr:strum bass:walk lead:{deg: falseta} prog=falseta dyn=mp
gold_full   8 | like=gold bell:{deg: answer, oct: 1} drums:palmas+{ohat: "......x.......x."} dyn=f | !drop:1@-1(keep=[gtr]) !impact
hang        4 | gtr:strum bass:walk prog=golden dyn=mf>p                          | !impact@+3(size=s)

mix drums -8 | fx -8 | gtr -6 hall=.2 | lead 17 hall=.25 | bass -2 | bell -16 hall=.4
master clean
