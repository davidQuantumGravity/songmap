# 4. Andalusian Gold (2:14). A minor / E Phrygian, 100 BPM, flamenco-pop. The same cadence, plain then golden.
# Technique (docs/GOLDEN_THEORY.md §4.2, golden Andalusian): the descent Am - G - F - E with golden chords
# in its gaps, Am -> Abg -> vAbg -> G -> ^F#g -> vF#g -> F (System 2, ~g ~g), and the last half step
# taken by planing, F -> vF -> ^E -> E, because no golden chord joins chords a half step apart
# (the half-step theorem). Under it the bass walks down the whole tetrachord in sixth-steps:
# A - Ab - vAb - G - ^F# - vF# - F - vF - ^E - E.
# Golden rules kept: golden chords take one beat, on beats 3 and 4; the voice sings two beats and rests
# while the guitar answers in gold (rel figures follow every golden chord); the strings and the violin are
# voice-led (hold, top), so their lines descend through the golden chords too.
# Form (54 bars):
#   intro    8  guitar alone on the Phrygian vamp E-F-E, palmas creep in, then the plain cadence with arpeggios
#   verse    8  the plain cadence: cante, rasgueado, walking bass, palmas and cajon
#   gold     8  the golden cadence: the voice calls two beats, the second guitar answers in gold; strings enter
#   falseta  8  guitar solo (picado) in the relative major, palmas only; IV-I and ii-vi golden passing chords
#   build    8  rumba: 16th strums, palmas thicken, the cajon doubles; iv-i, then F-G climbing to E; the last bar drops out
#   climax   8  the golden cadence twice at full strength: strings, violin countermelody, bell, the cante's high C
#   coda     4  the golden cadence once more, thinning
#   fin      2  F-E rasgueado and the last E, hanging (Phrygian half cadence)
# Instruments: gtr (rhythm guitar), req (picado guitar), drums (palmas = clap, cajon = kick + snare),
# bass, strings (pad/still, hold), lead (cante), vln (violin-like countermelody, top), bell (glass doubling), fx.
song "Andalusian Gold" 100 4/4 Am fps=30 seed=24 tail=4 tuning=36edo
inst gtr=string_pluck/still(brightness=.8) req=string_pluck/still(brightness=.9) lead=clean/lead strings=pad/still vln=clean/organ(attack=.12, partials=10, rolloff=1.1, release=.5) bell=clean/glass

prog vamp    "E:1 F:0.5 E:0.5 E:1 F:0.5 E:0.5 Am:1 G:1 F:1 E:1"
prog plain   "Am:1 G:1 F:1 E:1"
prog golden  "Am:0.5 ~g:0.25 ~g:0.25 G:0.5 ~g:0.25 ~g:0.25 F:0.5 vF:0.25 ^E:0.25 E:1"
prog falseta "C:1 G:1 F:0.75 ~:0.25 C:1 Dm:0.75 ~:0.25 Am:1 F:0.5 vF:0.25 ^E:0.25 E:1"
prog rumba   "Dm:1 Am:1 Dm:1 Am:1 F:1 G:1 F:0.5 G:0.5 E:1"
prog last    "F:0.5 E:0.5 E:1"

# Rhythm guitar (rel, oct -1: a guitar's own Am = A2 E3 A3 C4 E4). Every figure is a full bar.
intro_strum = {rel: "[R,5,R+,3+,5+]/2^ r/8 [R,5,R+,3+,5+]/16 [R,5,R+,3+,5+] [R,5,R+,3+,5+]/4 | [R,5,R+,3+,5+]/4^ r/8 [R,5,R+,3+,5+]/8 [R,5,R+,3+,5+]/4^ r/8 [R,5,R+,3+,5+]/16 [R,5,R+,3+,5+]", oct: -1}
# beats 1, 2, 2&, 3&, 4: the 3& and 4 strums land on the golden chords
strum = {rel: "[R,5,R+,3+,5+]/4^ [R,5,R+,3+,5+]/8 [R,5,R+,3+,5+] r/8 [R,5,R+,3+,5+] [R,5,R+,3+,5+]/4^", oct: -1}
light = {rel: "[R,5,R+,3+]/2 [R,5,R+,3+]/4 [R,5,R+,3+]", oct: -1}
rumba = {rel: "[R,5,R+,3+,5+]/8^ ([R,5,R+,3+,5+]/16) [R,5,R+,3+,5+] r/16 [R,5,R+,3+,5+] [R,5,R+,3+,5+]/8 [R,5,R+,3+,5+]/8^ ([R,5,R+,3+,5+]/16) [R,5,R+,3+,5+] r/16 [R,5,R+,3+,5+] [R,5,R+,3+,5+]/8", oct: -1}
# the golden rumba: a strike on every beat, so beat 4's golden chord is heard on time
grumba = {rel: "[R,5,R+,3+,5+]/8^ ([R,5,R+,3+,5+]/16) [R,5,R+,3+,5+] [R,5,R+,3+,5+]/8 [R,5,R+,3+,5+] [R,5,R+,3+,5+]/8^ ([R,5,R+,3+,5+]/16) [R,5,R+,3+,5+] [R,5,R+,3+,5+]/8^ [R,5,R+,3+,5+]", oct: -1}
fin_strum = {rel: "[R,5,R+,3+,5+]/8^ [R,5,R+,3+,5+]/16 [R,5,R+,3+,5+] [R,5,R+,3+,5+]/4 [R,5,R+,3+,5+]/8^ [R,5,R+,3+,5+]/16 [R,5,R+,3+,5+] [R,5,R+,3+,5+]/4 | [R,5,R+,3+,5+]/1^", oct: -1}

# Second guitar (req): arpeggios, the answer in gold, picado.
arps = {rel: "r/1 | r/1 | r/1 | r/1 | R/8 5 R+ 3+ 5+ 3+ R+ 5 | R/8 5 R+ 3+ 5+ 3+ R+ 5 | R/8 5 R+ 3+ 5+ 3+ R+ 5 | R/8 5 R+ 3+ 5+ 3+ R+ 5"}
gold_answer = {rel: "r/2 R+/16 3+ 5+ R++ 5+/8 3+"}
tremolo = {rel: "r/1 | r/1 | r/1 | r/1 | R/16 5 R+ 5 3+ 5 R+ 5 R 5 R+ 5 3+ 5 R+ 5 | R/16 5 R+ 5 3+ 5 R+ 5 R 5 R+ 5 3+ 5 R+ 5 | R/16 5 R+ 5 3+ 5 R+ 5 R 5 R+ 5 3+ 5 R+ 5 | R/16 5 R+ 5 3+ 5 R+ 5 R 5 R+ 5 3+ 5 R+ 5"}
# deg 0 = A4: the falseta in C major (deg 2 = C5), resting on each golden or planing beat.
picado = "=f 2/8 4 6 4 9/4 7/8 6 | 8/8 6 4 6 8/4 6 | 7/16 6 5 6 7/8 9 7/4 r/4 | 6/8 4 2 4 6/2 | 5/16 4 3 4 5/8 7 5/4 r/4 | 4/8 2 0 2 4/2 | 5/8 7 9/4 r/2 | {5}4/4 #6/8 8 7 #6 4/4"

walk = {rel: "R/4 R R R", oct: -2}                    # a root on every beat: the descent in sixth-steps
drive = {rel: "R/4 R/8 R R/4 R", oct: -2}
rbass = {rel: "R/4. R/8 R/4 5", oct: -2}

palmas = {kick: "X.......x.......", clap: {steps: "X..x..x...x.x...", vel: [0.9, 0.55, 0.7, 0.55, 0.65]}, hat: {steps: "-.-.-.-.-.-.-.-.", vel: [0.3]}}
cajon = palmas + {snare: "....X..o....X.o."}
sordas = {clap: {steps: "..x...x...x...x.", vel: [0.75, 0.55, 0.8, 0.55]}}
creep = {clap: {steps: "................|................|..x...x...x...x.|..x...x...x...x.|..x...x...x...x.|..x...x...x...x.|X..x..x...x.x...|X..x..x...x.x...", vel: [0.6, 0.4, 0.5, 0.4]}}
build_beat = {kick: "X.....x.X.....x.", clap: {steps: "X..x..x...x.x...|X..x..x...x.x...|X..x..x...x.x...|X..x..x...x.x...|X.xx.xX.X.xx.xX.|X.xx.xX.X.xx.xX.|XxxxXxxxXxxxXxxx|X...............", vel: [0.9, 0.5, 0.7, 0.5, 0.75]}, snare: "....X..o....X..o|....X..o....X..o|....X..o....X..o|....X..o..o.X.oo|....X..o..o.X.oo|....X..o..o.X.oo|x.x.x.x.xxxxXXXX|................", hat: {steps: "-.x.-.x.-.x.-.x.", vel: [0.3, 0.45]}}
fiesta = {kick: "X.....x.X.....x.", snare: "....X..o....X.o.", clap: {steps: "X.xX.xX.X.xX.xX.", vel: [1.0, 0.5, 0.7, 0.5, 0.8]}, hat: {steps: "x.x.x.x.x.x.x.x.", vel: [0.45, 0.25, 0.35, 0.25]}, ohat: "......x.......x."}

# deg 0 = A4 (A minor); over E the melody uses G# (#6) and the Phrygian F -> E grace.
cante = "=mf 4/4. 5/8 4/4 2 | 1/4. 2/8 1/2 | 0/4 1/8 0 -2/2 | {-2}-3/1 | 7/4. 8/8 7/4 4 | 6/4. 7/8 6/2 | 5/4 6/8 5 3/2 | {5}4/1"
answer = "=f 4/4. 5/8 r/2 | 1/4. 2/8 r/2 | 0/4 1/8 0 r/2 | {-2}-3/1 | 7/4. 8/8 r/2 | 6/4. 7/8 r/2 | 5/4 6/8 5 r/2 | {5}4/1"
rise = "=mf 5/4. 4/8 3/4 5 | 4/2 r/4 0/8 2 | 3/4. 5/8 7/4 5 | 4/2. r/4 | 5/4. 6/8 7/2 | 6/4. 7/8 8/2 | 7/4 5 8/4 6 | {5}4/1"
peak = "=f 4/4. 5/8 r/2 | 1/4. 2/8 r/2 | 0/4 1/8 0 r/2 | {-2}-3/1 | =ff 9/4.^ 8/8 r/2 | 8/4. 7/8 r/2 | 7/4 6/8 5 r/2 | {5}4/1"
farewell = "=mf 7/4. 8/8 r/2 | 6/4. 7/8 r/2 | 5/4 6/8 5 r/2 | {5}4/1"

# name    bars | parts and settings                                                                  | events
intro      8 | gtr:intro_strum req:arps drums:creep prog=vamp dyn=p<mf
verse      8 | gtr:strum bass:walk drums:palmas lead:{deg: cante} prog=plain dyn=mp
gold       8 | like=verse req:gold_answer strings:hold drums:cajon lead:{deg: answer} prog=golden dyn=mf  | !impact(size=s)
falseta    8 | gtr:light req:{deg: picado} drums:sordas prog=falseta dyn=mf
build      8 | gtr:rumba req:tremolo bass:rbass drums:build_beat lead:{deg: rise} prog=rumba dyn=mp<mf    | !riser:2@+8
climax     8 | gtr:grumba req:gold_answer bass:drive strings:hold vln:top(oct=1) drums:fiesta lead:{deg: peak} bell:{deg: peak, oct: 1} prog=golden dyn=f | !drop:1@-1(keep=[gtr]) !impact(size=xl)
coda       4 | gtr:strum req:gold_answer bass:walk strings:hold drums:palmas lead:{deg: farewell} prog=golden dyn=mf>p
fin        2 | gtr:fin_strum bass:{rel: "R/2 R | R/1", oct: -2} strings:hold vln:top(oct=1) prog=last dyn=mf>p   | !impact@+1(size=m)

mix drums -8 | fx -8 | gtr -8 hall=.2 pan=-.2 | req -2 hall=.25 pan=.3 | lead 17 hall=.25 | bass -2 | strings -20 hall=.3 | vln -13 hall=.35 pan=.15 | bell -16 hall=.4
master clean
