# 3. Tape Bloom (2:22). A minor, 90 BPM, lo-fi. Golden colour chords, held like borrowed chords.
# Technique (docs/GOLDEN_BLENDING.md §9, golden modal mixture by projection): a diatonic chord bends into
# its nearest golden triad π(X) for half a bar. One note stays, the other two slide a sixth-step:
#   Fmaj7 -> Fg   (A falls to vA, C rises to ^C over a steady F; the 7th E stays, since the golden
#                  seventh 8/φ³ is exactly a 12-ET major seventh, so Fg + E is the true golden seventh Fg7)
#   E7    -> Eg   (a dominant whose third sags a sixth-step: a "blue" dominant)
#   Am    -> vAg  (the tonic's golden shadow, in the drum-less bridge)
# In lo-fi the bend reads as tape wow, so the colour is felt rather than announced.
# The coda is the golden Picardy third: Am - Am(^3) - Ag - A, the third climbing 9 -> 10 -> 11 -> 12 sixth-steps
# under a held A, from minor through silver and golden to major.
# Craft: the melody holds the common tone (F over Fg, E over Eg and vAg) or rests on every colour chord.
song "Tape Bloom" 90 4/4 Am fps=30 seed=23 tail=4 tuning=36edo
inst ep=epiano/still keys=keys/still(hardness=.3) bass(cutoff=480, glide=.08)

prog loop  "Am9:1 Dm9:1 Fmaj7:0.5 Fg:0.5 E7:1"
prog bloom "Cmaj7:1 Fmaj7:0.5 Fg:0.5 Dm7:1 E7:0.5 Eg:0.5"
prog shade "Am:1 vAg:1 Fmaj7:1 Fg:1"
prog home  "E7:1 Am:0.5 Am(^3):0.5 Ag:1 A:1"

lazy = {kick: "x.....x..x..|x.....x.....", snare: "...X.....X.o", hat: {steps: "x.xx.xx.xx.x", vel: [0.5, 0.25, 0.45, 0.22, 0.5, 0.25, 0.42, 0.3]}}
comp = {rel: "[3,7,9]/2 [3,7,9]/4 r/8t r [3,7,9]"}  # rootless 9ths: beat 1, beat 3 (where colour chords bloom), a late triplet
slide = {rel: "R/4. r/8 5/4~ R", oct: -2}            # the 5th glides down into the root

# deg 0 = A4. Phrases end on long notes; colour beats get a common tone (F, E) or a rest.
t1 = "=mp r/4 4/8 2 0/4 2/8 4 | 3/4. 2/8 0/2 | 5/4 4/8 2 r/2 | 1/2. r/4"
t2 = "r/4 7/8 6 4/4 2/8 4 | 3/4. 4/8 5/2 | 4/4 2/8 4 5/2 | 4/2 #6/4 r/4"
b1 = "=mf 4/4 6/8 7 9/4 7 | 8/4. 7/8 5/2 | 5/4 3 2 3 | 4/2 r/2"
b2 = "4/4 6/8 7 9/4 7 | 9/4. 8/8 5/2 | 5/4 3 2 3 | 4/1"
tune = {deg: t1 + " | " + t2}
bloom_tune = {deg: b1 + " | " + b2}
lonely = {deg: "=p 0/4 2 4/2 | 4/1 | 5/4 4 2 0 | 5/1"}
last = {deg: "=mp 4/2 #6/2 | 7/1 | 7/1 | 7/1"}

# name   bars | parts and settings                                              | events
dusk       4 | ep:comp fx:ticks prog=loop dyn=pp<p
walk       8 | like=dusk drums:lazy bass:slide dyn=p<mp
tune_a     8 | like=walk keys:tune dyn=mp
bloom      8 | like=walk keys:bloom_tune prog=bloom dyn=mp<mf
alone      4 | ep:{rel: "[3,7,9]/1"} keys:lonely prog=shade dyn=p
tune_b     8 | like=tune_a dyn=mp                                             | !impact(size=s)
picardy    4 | ep:{rel: "[R,3,5]/2"} bass:{rel: "R/1", oct: -2} keys:last prog=home dyn=mp>p

mix drums -6 | fx -4 | bass -2 | ep -11 hall=.2 | keys 3 hall=.25
master clean
