# 3. Tape Bloom (about 2:23). A minor, 90 BPM, lo-fi hip-hop / neo-soul: warm, late-night, a little hazy.
# Golden colour chords, held like borrowed chords.
# Technique (docs/GOLDEN_BLENDING.md §9, golden modal mixture by projection): a diatonic chord bends into
# its nearest golden triad π(X) for half a bar. One note stays, the other two slide a sixth-step:
#   Fmaj7 -> Fg   (A falls to vA, C rises to ^C over a steady F; the 7th E stays, since the golden
#                  seventh 8/φ³ is exactly a 12-ET major seventh, so Fg + E is the true golden seventh Fg7)
#   E7    -> Eg   (the third sinks to vG#, and the voiced seventh D rises to D#, the golden seventh)
#   Am    -> vAg  (the tonic's golden shadow, held a whole bar in the drum-less interlude)
# In lo-fi the bend reads as tape wow, so the colour is felt rather than announced.
# The coda is the golden Picardy third: Am - Am(^3) - Ag - A, the third climbing C - ^C - vC# - C#
# under a held A, from minor through silver and golden to major.
# Craft: the melodies hold the common tone (F over Fg, E over Eg and vAg) or rest on every colour chord;
# every sounding part changes with the chord (rel figures with a strike on beat 3, voiced `hold` pad).
#
# Form (52 bars + 4 s tail):
#   dusk     4  electric piano, a faint pad and vinyl crackle, the loop  Am9 Dm9 Fmaj7|Fg E7
#   walk     4  groove in: kick and swung hats, the snare joins in bar 3, sliding bass
#   theme_a  8  the piano theme (t1 question, t2 answer), full swung kit with ghosts and a bar-4 fill
#   bloom    8  theme B over Cmaj7 Fmaj7|Fg Dm7 E7|Eg: pad and glass sparkles enter, rim clicks
#   shade    8  drum-less interlude: Am - vAg, the tonic's golden shadow, lonely piano over pad
#   solo     8  flute solo over the loop, nylon-guitar ripples, a busier kit; one-bar drop before the peak
#   reprise  8  the peak: theme A' climbs to E6, flute countermelody crossing under it, guitar, pad,
#               bells, claps and open hats, a bouncing bass
#   picardy  4  the beat stops; E7 then the golden Picardy, A held over the climbing third
# Instruments: epiano/still (rootless 9ths), keys/still (melody), bass (glide), swung kit, fx ticks,
# pad/still (wash: hold), string_pluck/still (gtr), clean/lead (flute), clean/glass (bell).
song "Tape Bloom" 90 4/4 Am fps=30 seed=23 tail=4 tuning=36edo
inst ep=epiano/still keys=keys/still(hardness=.3) bass(cutoff=480, glide=.08) wash=pad/still gtr=string_pluck/still(brightness=.55) flute=clean/lead bell=clean/glass

prog loop  "Am9:1 Dm9:1 Fmaj7:0.5 Fg:0.5 E7:1"
prog loop7 "Am7:1 Dm7:1 Fmaj7:0.5 Fg:0.5 E7:1"   # under the solo and the peak: the pad leaves out the 9ths
prog bloom "Cmaj7:1 Fmaj7:0.5 Fg:0.5 Dm7:1 E7:0.5 Eg:0.5"
prog shade "Am:1 vAg:1 Fmaj7:0.5 Fg:0.5 Dm9:1 Am:1 vAg:1 Fmaj7:0.5 Fg:0.5 E7:1"
prog home  "E7:1 Am:0.5 Am(^3):0.5 Ag:1 A:1"

# Drums on the 12-step (triplet) grid: swung hats, ghosted snares, a fill in every 4th bar.
hats = {steps: "x.xx.xx.xx.x", vel: [0.5, 0.25, 0.45, 0.22, 0.5, 0.25, 0.42, 0.3]}
walkin = {kick: "x.....x..x..|x.....x.....", hat: hats, snare: "............|............|...X.....X..|...X..o..XoX"}
lazy = {kick: "x.....x..x..|x.....x.....|x.....x..x..|x..x..x.....", snare: "...X.....X.o|...X..o..X..|...X.....X.o|...X..o..XoX", hat: hats}
lazy_b = lazy + {rim: "............|......-....."}
lazy_s = {kick: "x.....x..x.x|x.....x..x..|x.....x..x.x|x..x..x.....", snare: "...X..o..X.o|...X.....X.o|...X..o..X.o|...X..o.oXoX", hat: hats, ohat: "............|............|............|.........x.."}
lazy_f = lazy + {clap: "...-.....-..", ohat: "............|.........x.."}

# Electric piano: rootless 9ths, a strike on beat 3 wherever a colour chord blooms.
# Under a melody the minor chords drop their 9th ([3,5,7]), so a held 3rd (F over Dm, C over Am) never sits a
# half step above it; the major-7th chords keep [3,7,9], so E rings on as the golden seventh of Fg.
def c1(v): "[" + v + "]/2 [" + v + "]/4 r/8t r [" + v + "]"      # beat 1, beat 3, a late triplet
def c2(v): "[" + v + "]/4 r/8t r [" + v + "] [" + v + "]/2"      # beat 1, a pushed triplet, beat 3
def c3(v): "[" + v + "]/2 [" + v + "]"                           # beats 1 and 3, for the interlude
n = "3,7,9"
m = "3,5,7"
comp = {rel: c1(n)}
comp_m = {rel: c1(n) + " | " + c1(m) + " | " + c1(n) + " | " + c1(n)}
comp_b = {rel: c1("3,5,9") + " | " + c1(n) + " | " + c1(m) + " | " + c1(n)}
comp2 = {rel: c2(n) + " | " + c2(m) + " | " + c2(n) + " | " + c2(n)}
still = {rel: c3(m) + " | " + c3(n) + " | " + c3(n) + " | " + c3(n)}
slide = {rel: "R/4. r/8 5/4~ R", oct: -2}                 # the 5th glides down into the root
bounce = {rel: "R/4 r/8t R R+ 5/4~ R/8 R+", oct: -2}
ripple = {rel: "5-/8t R 3 5/4 5-/8t R 3 R+/4"}            # nylon guitar under the melody, restruck on beat 3

# deg 0 = A4. Phrases end on long notes; colour beats get a common tone (F, E) or a rest.
t1 = "=mp r/4 4/8 2 0/4 2/8 4 | 3/4. 2/8 0/2 | 5/4 4/8 2 r/2 | 1/2. r/4"
t2 = "r/4 7/8 6 4/4 2/8 4 | 3/4. 4/8 5/2 | 4/4 2/8 4 5/2 | 4/2 #6/4 r/4"
t1f = "=mf r/4 4/8 2 0/4 2/8 {5}4 | 3/4. 2/8 0/2 | 5/4 4/8 2 r/2 | 1/2. r/4"
t2f = "r/4 7/8 9 11/4^ 9/8 7 | 9/4. 7/8 5/2 | 4/4 2/8 4 5/2 | 4/2 #6/4 r/4"
b1 = "=mf 4/4 6/8 7 9/4 7 | 8/4. 7/8 5/2 | 5/4 3 2 3 | 4/2 r/2"
b2 = "4/4 6/8 7 9/4 7 | 9/4. 8/8 5/2 | 5/4 3 2 3 | 4/1"
tune = {deg: t1 + " | " + t2}
tune2 = {deg: t1f + " | " + t2f}
bloom_tune = {deg: b1 + " | " + b2}
lonely = {deg: "=mp 0/4 2 4/2 | 4/1 | 5/4 4 5/2 | 3/4 2 0/2 | r/4 2 4 7 | 4/2. r/4 | 5/4 7 5/2 | 4/2 r/2"}
last = {deg: "=mp 4/2 #6/2 | 7/1 | 7/1 | 7/1"}

# Flute: a solo over the loop, then a countermelody that crosses under the climbing theme.
s1 = "=mp r/8t 2 4 7/4 6/8t 7 6 4/4 | 5/4. 3/8 2/8t 3 5 7/4 | 9/4 7/8 4 5/2 | 4/4 #6/8t 8 #6 4/2"
s2 = "< r/4 11/8t 9 8 7/4 6/8 4 =mf | 5/8 6 5 3 2/2 | 2/8t 3 4 5/2. | 8/4. #6/8 4/2"
solo_tune = {deg: s1 + " | " + s2}
counter = {deg: "=mp 11/2. 9/4 | 10/2 9/2 | 9/2 r/2 | 8/2 #6/2 | 4/2 0/2 | 3/1 | 2/2 r/2 | 1/1"}

# Glass sparkles: only on diatonic bars, on chord tones that ring on into the next chord.
bell_b = {deg: "=pp r/2 11/8' 9' r/4 | r/1 | r/2. 7/8' 10' | r/1"}
bell_p = {deg: "=pp r/2. 11/8' 9' | r/1 | r/1 | r/1 | r/2. 9/8' 11' | r/2 10/8' 9' r/4 | r/1 | r/1"}
last_bell = {deg: "r/1 | r/1 | r/1 | =p r/4 11/4' #9/2"}
last_strum = {rel: "r/1 | r/1 | r/1 | [R,5,R+,3+]/1"}

# name   bars | parts and settings                                                       | events
dusk       4 | ep:comp wash:hold fx:ticks prog=loop dyn=p<mp
walk       4 | like=dusk -wash drums:walkin bass:slide dyn=p<mp
theme_a    8 | like=walk ep:comp_m drums:lazy keys:tune dyn=mp
bloom      8 | like=theme_a ep:comp_b drums:lazy_b keys:bloom_tune wash:hold bell:bell_b prog=bloom dyn=mp<mf
shade      8 | ep:still wash:hold keys:lonely fx:ticks prog=shade dyn=p<mp
solo       8 | ep:comp2 drums:lazy_s bass:slide gtr:ripple flute:solo_tune fx:ticks prog=loop7 dyn=mp<mf
reprise    8 | like=solo ep:comp_m drums:lazy_f bass:bounce keys:tune2 flute:counter wash:hold bell:bell_p dyn=mf<f | !impact(size=s) !drop:1@-1(keep=[ep, flute, fx])
picardy    4 | ep:{rel: "[R,3,5]/2 [R,3,5]"} wash:hold bass:{rel: "R/1", oct: -2} keys:last gtr:last_strum bell:last_bell fx:ticks prog=home dyn=mp>p

mix drums -6 | fx -4 | bass -2 | ep -11 hall=.2 | keys 5 hall=.25 | wash -24 hall=.3 | gtr -6 hall=.25 | flute -1 hall=.3 | bell -10 hall=.4
master clean
