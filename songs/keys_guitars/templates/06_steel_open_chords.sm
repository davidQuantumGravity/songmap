# Guitar notes: low root/fifth plus one upper third use separated strings. Alternate the bass note and the small strum; omit strokes before the reply.
# Guitar expression: soft initial strums, stronger lifted pulse and a spread final chord. Gate lengths damp the steel-string sample; these are not recorded palm mutes.
# Bass notes: roots below the guitar with a fifth reply; drums keep a light two/four pulse and subtract at the end.
song "Steel open chords" 104 4/4 G seed=96 tail=2 mood=balanced
inst gtr=sampler/steel_guitar bass=sampler/roundwound_bass
kit kick=sampler/blonde_bop_kick snare=sampler/blonde_bop_sidestick hat=sampler/blonde_bop_hat
chords G:2 C:2 D:2 G:2
strum 2 | gtr:{deg: "=mp -7/4^ [-3,2]/4 r/8 [-7,-3,2]/8 r/4 | -7/4 [-3,2]/4 -3/4 r/4", oct: -1} bass:{rel: "=p R/2 5/4 r/4 | R/2 r/2", oct: -2} drums:{kick: "X.......x.......", snare: "....x.......x...", hat: "x...-...x...-..."}
open 2 | gtr:{deg: "=mp -4/4^ [0,5]/4 r/8 [-4,0,5]/8 r/4 | -4/4 [0,5]/4 0/4 r/4", oct: -1} bass:{rel: "=mp R/2 5/4 r/4 | R/2 r/4 5/4", oct: -2} drums:{kick: "X.......x.......", snare: "....x.......x...", hat: "x.-.x.-.x.-.x.-."}
push 2 | gtr:{deg: "=mf [-3,1,6]/4^ r/8 [1,6]/8 [-3,1,6]/4 r/4 | -3/4 [1,6]/4 r/4 [-3,1,6]/8' r/8", oct: -1} bass:{rel: "=mf R/4 r/4 5/4 r/4 | R/2 5/4 r/4", oct: -1} drums:{kick: "X.....x.x.......", snare: "....x.......X...", hat: "x.-.x.-.x.-.x.-."}
home 2 | gtr:{deg: "=mp -7/4 [-3,2]/4 -3/4 r/4 | =p [-7,-3,2]/2._ r/4", oct: -1} bass:{rel: "=p R/2 5/4 r/4 | R/2._ r/4", oct: -2} drums:{kick: "X.......x.......|X...............", snare: "....x.......x...|................", hat: "x...-...x.......|................"}
set parts_feel.gtr.strum_ms=12
mix gtr -4 hall=.06 | bass -7 sc=0 | drums -16 hall=.025
master standard lufs=-17 glue=none
