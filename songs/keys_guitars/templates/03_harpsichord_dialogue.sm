# Upper voice notes: an arch, sequential reply, stronger cadence, then a spaced ending. Articulation supplies shape on a velocity-insensitive instrument.
# Lower voice notes: broken triads stay below the upper line, answer during its rests, and simplify at the final cadence.
# Both hands keep independent note lengths; short releases reveal the plucked-keyboard character instead of pretending to be piano pedal.
song "Harpsichord dialogue" 108 4/4 C seed=93 tail=2 mood=balanced
inst keys=sampler/english_harpsichord low=sampler/english_harpsichord
chords C:2 Am:2 Dm:1 G7:1 C:2
arch 2 | keys:{deg: "=mp 0/4_ 2/8 4/8 7/4_ r/4 | 6/8 4/8 2/4 0/4 r/4", oct: 1} low:{deg: "0/4 4/4 2/4 4/4 | 0/2 4/4 r/4", oct: -1}
sequence 2 | keys:{deg: "=mp 5/4 7/8 9/8 12/4_ r/4 | 11/8 9/8 7/4 5/4 r/4"} low:{deg: "-2/4 2/4 0/4 2/4 | -2/2 2/4 r/4", oct: -1}
cadence 2 | keys:{deg: "=mf 8/4 10/8 12/8 10/4 8/4 | 6/4_ 4/8 3/8 1/4 6/4"} low:{deg: "1/4 5/4 3/4 5/4 | -3/4 1/4 -1/4 1/4", oct: -1}
release 2 | keys:{deg: "=mp 7/4_ 4/4 2/4 r/4 | =p [0,2,4]/2_ r/2"} low:{deg: "0/2 4/4 r/4 | 0/2_ r/2", oct: -1}
mix keys -5 hall=.08 | low -4 hall=.08
master standard lufs=-18 glue=none
