# Organ notes: two swaying chord gestures per 6/8 bar, with an upper reply and a held landing. Registration and gates supply expression, not piano-like hammer dynamics.
# Bass notes: dotted-quarter roots and fifths follow the sway; the final root lasts a bar.
# Drums: six eighth positions per bar, soft hat answers, rim on the second dotted beat; a sparse final bar lets the organ release.
song "Six-eight organ" 76 6/8 C seed=94 tail=2 mood=balanced
inst keys=organ/soft_chorale bass=sampler/jazz_bass
kit kick=sampler/blonde_bop_kick rim=sampler/blonde_bop_sidestick hat=sampler/blonde_bop_hat
chords C:2 F:2 G7:2 C:2
sway 2 | keys:{rel: "[R,3,5]/4._ [3,5,R+]/4. | [R,3,5]/4._ r/8 [3,5]/4"} bass:{rel: "=p R/4. 5/4. | R/4. 5/4.", oct: -2} drums:{kick: "X.....", rim: "...x..", hat: "x--x--"}
answer 2 | keys:{rel: "[R,3,5]/4. [3,5,R+]/4. | 3+/8 5+/8 3+/8 [R,3,5]/4."} bass:{rel: "=mp R/4. 5/4. | R/4. r/8 5/4", oct: -2} drums:{kick: "X..x..", rim: "...x..", hat: "x--x--"}
turn 2 | keys:{rel: "[3,5,7]/4._ [5,7,R+]/4. | [3,5,7]/4. 5/8 3/8 7-/8"} bass:{rel: "=mp R/4. 5/4. | R/4. 5/4.", oct: -2} drums:{kick: "X.....", rim: "...x..", hat: "x--x--|x--x-."}
settle 2 | keys:{rel: "[R,3,5]/4._ [3,5,R+]/4. | [R,3,5]/2._"} bass:{rel: "=p R/4. 5/4. | R/2._", oct: -2} drums:{kick: "X.....|X.....", rim: "...x..|......", hat: "x--x--|......"}
mix keys -15 hall=.12 | bass 3 sc=0 | drums -13 hall=.03
master standard lufs=-18 glue=none
