# Acoustic closed hi-hat: Recorded hi-hat with alternate takes; an acoustic kit's short timekeeping voice.
song "Acoustic closed hi-hat" 100 4/4 C fps=30 seed=99 tail=3 tuning=36edo
kit kick=sampler/hi_hat
soft 1 | drums:{kick: "x...o...x...o..."} dyn=p
medium 1 | drums:{kick: "X...x...X...x..."} dyn=mf
hard 1 | drums:{kick: "X.x.X.x.X.x.X.x."} dyn=f
last 1 | drums:{kick: "X..............."} dyn=mp
mix drums -12
master standard lufs=-18 glue=none
