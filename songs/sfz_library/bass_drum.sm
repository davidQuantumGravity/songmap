# Acoustic bass drum: Recorded concert bass drum; use as a kit piece, not a pitched bass instrument.
song "Acoustic bass drum" 100 4/4 C fps=30 seed=99 tail=3 tuning=36edo
kit kick=sampler/bass_drum
soft 1 | drums:{kick: "x...o...x...o..."} dyn=p
medium 1 | drums:{kick: "X...x...X...x..."} dyn=mf
hard 1 | drums:{kick: "X.x.X.x.X.x.X.x."} dyn=f
last 1 | drums:{kick: "X..............."} dyn=mp
mix drums -12
master standard lufs=-18 glue=none
