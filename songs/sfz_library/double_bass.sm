# Pizzicato double bass: Plucked acoustic bass with alternate takes; jazz and chamber bass lines, no synth glide.
song "Pizzicato double bass" 100 4/4 C fps=30 seed=99 tail=3 tuning=36edo
inst voice=sampler/double_bass
soft 1 | voice:{deg: "0/4 2 4 r/4", oct: -2} dyn=p
medium 1 | voice:{deg: "0/4 2 4 r/4", oct: -2} dyn=mf
hard 1 | voice:{deg: "0/4 2 4 r/4", oct: -2} dyn=f
sixth 1 | voice:{deg: "^0/1", oct: -2} dyn=mp
mix voice -6 hall=.08
master standard lufs=-18 glue=none
