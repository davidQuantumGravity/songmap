# Spiccato cellos: Short bowed cello attacks with alternate takes; rhythmic ostinatos and replies.
song "Spiccato cellos" 100 4/4 C fps=30 seed=99 tail=3 tuning=36edo
inst voice=sampler/cello_spiccato
soft 1 | voice:{deg: "0/4 2 4 r/4", oct: -1} dyn=p
medium 1 | voice:{deg: "0/4 2 4 r/4", oct: -1} dyn=mf
hard 1 | voice:{deg: "0/4 2 4 r/4", oct: -1} dyn=f
sixth 1 | voice:{deg: "^0/1", oct: -1} dyn=mp
mix voice -6 hall=.08
master standard lufs=-18 glue=none
