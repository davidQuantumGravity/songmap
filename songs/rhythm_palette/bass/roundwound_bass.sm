# Roundwound neck bass: Killer KB-Simmony neck pickup; five dynamic layers and three alternate takes. Warm electric bass. No scripted slides or live keyswitches.
# Compare the soft and firm phrases; then listen to short notes and space between answers.
song "Bass: Roundwound neck bass" 100 4/4 Dm fps=30 seed=82 tail=2 mood=balanced
inst bass=sampler/roundwound_bass(gain_db=0)
chords Dm
soft 2 | bass:{rel: "R/4. r/8 5/8 R+/8 5/4 | R/4 r/8 5/8 R/4 r/4", oct: -2} dyn=p<mp
answer 2 | bass:{rel: "R/8' R r/8 5/8 R+/4 r/4 | 5/4 R/2 r/4", oct: -2} dyn=mf>mp
mix bass -4 sc=0
master standard lufs=-18 glue=none
