# Electronic set 7: low_thud / noisy. These are synthesis recipes, not sampled hardware clones.
song "Electronic set 7: low_thud / noisy" 120 4/4 Dm fps=30 seed=82 tail=2 mood=balanced
inst bass=bass/reedy(gain_db=0)
kit kick=kick/low_thud(gain_db=0) snare=snare/noisy(gain_db=-3) fill=snare/noisy(gain_db=-3) rim=snare/dry_rim(gain_db=-6) hat=hat/dark_closed(gain_db=-8) ohat=hat/soft_open(gain_db=-10)
chords Dm Bb F C
groove swing=.53/16
setup 2 | drums:broken_beat bass:syncopated dyn=mp
answer 2 | drums:{kick: "X.......x.x.....", snare: "....X..o....X...", hat: "x.x.x.x.x.x.x.x.", ohat: "..............x."} bass:pocket dyn=mf>mp
mix bass -6 sc=.15 | drums -5 hall=.02
master standard lufs=-18 glue=none
