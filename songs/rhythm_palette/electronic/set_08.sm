# Electronic set 8: distorted / industrial. These are synthesis recipes, not sampled hardware clones.
song "Electronic set 8: distorted / industrial" 120 4/4 Dm fps=30 seed=82 tail=2 mood=balanced
inst bass=bass/growl(gain_db=0)
kit kick=kick/distorted(gain_db=0) snare=snare/industrial(gain_db=-3) fill=snare/industrial(gain_db=-3) rim=snare/dry_rim(gain_db=-6) hat=hat/grain(gain_db=-8) ohat=hat/metal_open(gain_db=-10)
chords Dm Bb F C
groove swing=.53/16
setup 2 | drums:broken_beat bass:syncopated dyn=mp
answer 2 | drums:{kick: "X.......x.x.....", snare: "....X..o....X...", hat: "x.x.x.x.x.x.x.x.", ohat: "..............x."} bass:pocket dyn=mf>mp
mix bass -6 sc=.15 | drums -5 hall=.02
master standard lufs=-18 glue=none
