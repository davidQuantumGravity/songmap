# Flute notes: a light upper question leaves two beats for the oboe. Expression: detached pickup, small arch, breath at every answer.
# Oboe notes: lower answering thirds and a delayed dominant resolution. Expression: tenuto arrivals, gentle detached tails.
# Clarinet notes: a calm middle-register counterline; no constant doubling. Expression: connected pairs separated by written rests.
# Bassoon notes: roots and fifths anchor the quartet, then a short rising link. Expression: firm low entrances, lighter passing notes.
song "Woodwind replies" 108 4/4 C seed=202 tail=2 mood=balanced
inst flute=sampler/flute oboe=sampler/oboe clar=sampler/clarinet bsn=sampler/bassoon
chords C:2 F:2 G7:2 C:2
call 2 | flute:{deg: "=p 0/8' 2/8 4/4_ r/2 | 2/4 0/4 r/2", oct: 1} oboe:{deg: "=p r/2 4/4 2/4 | r/2 0/4 r/4"} clar:{deg: "=p 2/2_ r/4 4/4 | 4/2_ r/2"} bsn:{deg: "=p 0/2_ -3/4 r/4 | 0/2_ r/2", oct: -1}
answer 2 | flute:{deg: "=mp r/2 5/4 4/4 | 3/2_ r/2", oct: 1} oboe:{deg: "=mp 3/4_ 5/8 4/8 3/4 r/4 | 2/4 1/4 r/2"} clar:{deg: "=p 0/2_ r/4 2/4 | 3/2_ r/2"} bsn:{deg: "=p 3/2_ 0/4 r/4 | 3/2_ r/2", oct: -1}
turn 2 | flute:{deg: "=mf 6/4^ 5/8 4/8 2/4 r/4 | r/2 4/4 2/4", oct: 1} oboe:{deg: "=mp r/2 4/4 3/4 | 1/2_ r/2"} clar:{deg: "=mp 1/4 3/4 r/4 4/4 | -1/2_ r/2"} bsn:{deg: "=mp 4/2_ 1/4 2/4 | 4/4 5/8 6/8 4/4 r/4", oct: -1}
home 2 | flute:{deg: "=mp 2/4 0/4 r/2 | =p 0/2_ r/2", oct: 1} oboe:{deg: "=p r/2 4/4 2/4 | 2/2_ r/2"} clar:{deg: "=p 4/2_ 2/4 r/4 | -3/2_ r/2"} bsn:{deg: "=p 0/2_ -3/4 r/4 | 0/2_ r/2", oct: -1}
mix flute -6 pan=-.2 hall=.08 | oboe -9 pan=.15 hall=.08 | clar -10 pan=.3 hall=.08 | bsn -5 pan=-.1 hall=.08
master standard lufs=-18 glue=none
