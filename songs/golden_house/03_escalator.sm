# 3. Escalator. Golden House, song 3 of 5 (textbook Chapter 49). Progressive house in C major (A minor colour),
# 126 BPM: a sidechained saw pad, a pluck arpeggio, a rolling off-beat bass, a lead, and long builds.
# Golden techniques: the golden escalator and the golden authentic cadence (Chapters 28 and 29). In every loop F
# climbs to G through two golden chords, a beat each, the passing engine moving every voice by sixth-steps; and in
# the build and the drop G reaches C through vEbT13/G and vCg/G, the four-chord golden authentic cadence, which
# lands the drop. The lead holds G through the cadence (G is a tone of every chord in it) and over vF#g (no rub),
# and rests on ^F#g, whose ^F# lies two sixth-steps under G.
# Form (80 bars): intro 16, rise 16, breakdown 16, build 8, peak 16, outro 8.
song "Escalator" 126 4/4 C fps=30 seed=63 tail=4 tuning=36edo mood=techno
inst pad(voices=3, detune=3, drift=0, cutoff=2200, attack=.08, release=.5) arp=pluck/v0(cutoff=2600, decay=.35) lead=clean/lead bass=bass/v0(cutoff=600, drive=2, env_amt=2.2, env_decay=.1, sub=.5) bell=clean/glass
kit kick=kick/v0(tune=48, sweep=30, decay=.5, click=.3, drive=2) clap=clap/v0 hat=hat/v0 ohat=hat/v0_open snare=snare/v0(tone=200, snap=.5, noise_decay=.25)

prog loop      "Am:1 F:0.5 ~g:0.25 ~g:0.25 G:1 C:1"
prog slow      "Am:2 F:1.5 ~g:0.25 ~g:0.25 G:2 C:2"
prog climb     "Am:1 F:0.5 ~g:0.25 ~g:0.25 G:1 C:1 Am:1 F:0.5 ~g:0.25 ~g:0.25 G:1 G:0.5 vEbT13/G:0.25 vCg/G:0.25"
prog drop_loop "C:1 Am:1 F:0.5 ~g:0.25 ~g:0.25 G:0.5 vEbT13/G:0.25 vCg/G:0.25"
prog ending    "C:1 Am:1 F:0.5 ~g:0.25 ~g:0.25 G:0.5 vEbT13/G:0.25 vCg/G:0.25 C:4"

# the lead (C major, 0 = C): it holds G over every golden chord
theme = {deg: "=f 2/8 4/8 7/4 4/8^ 7/8 9/4 | 7/4. 5/8 4/4 2/4 | 5/4 3/4 4/4 r/4 | 6/4 4/4 4/2"}
theme_bell = "=mp r/1 | r/2 7/2 | r/1 | r/2 4/2"
slow_theme = {deg: "=mp 2/2 4/2 | 7/1 | 5/2. 3/4 | 4/2. r/4 | 6/2 4/2 | 4/1 | 2/2 4/2 | 7/1"}
offbeat = {rel: "r/8 R/8^ r/8 R/8 r/8 R/8^ r/8 R/8", oct: -2}
rolling = {rel: "r/16 R/16^ R/16 R/16 r/16 R/16 R/16 R/16 r/16 R/16^ R/16 R/16 r/16 R/16 R/16 R/16", oct: -2}

floor = {kick: "X...X...X...X...", hat: {steps: "..x...x...x...x.", vel: [0.4, 0.34, 0.44, 0.32]}}
groove = floor + {clap: "....X.......X..."}
peak_beat = groove with {ohat: {steps: "..x...x...x...x.|..x...x...x...x.|..x...x...x...x.|..x...x...x...x.|..x...x...x...x.|..x...x...x...x.|..x...x...x...x.|..x...x.x.x.xxxx", vel: [0.48, 0.4]}, hat: {steps: "xxXxxxXxxxXxxxXx", vel: [0.3, 0.18, 0.4, 0.18]}}
roll = {snare: {steps: "x.......x.......|x.......x.......|x...x...x...x...|x...x...x...x...|x.x.x.x.x.x.x.x.|x.x.x.x.x.x.x.x.|xxxxxxxxxxxxxxxx|xxxxxxxxxxxxxxxx", vel: [0.25, 0.3, 0.35, 0.4, 0.45, 0.5, 0.55, 0.6]}}

intro     16 | drums:floor bass:offbeat pad:hold(range=[50,67]) prog=loop dyn=p<mp
rise      16 | drums:groove bass:offbeat pad:hold(range=[50,67]) arp:up prog=loop dyn=p<mp | !impact(size=m)
breakdown 16 | pad:hold(range=[50,67]) lead:slow_theme bell:{deg: "=p r/1 | 7/1 | r/1 | 4/2. r/4 | r/1 | 4/1 | r/1 | 7/1", oct: 1} prog=slow dyn=p<mp
build      8 | drums:floor+roll pad:hold(range=[50,67]) arp:up lead:{deg: "=mp 4/1 | 4/2. r/4"} prog=climb dyn=p<mf | !riser:4@+8
peak      16 | drums:peak_beat bass:rolling pad:hold(range=[50,67]) arp:up lead:theme bell:{deg: theme_bell, oct: 1} prog=drop_loop dyn=f | !impact(size=xl)
outro      8 | drums:groove bass:offbeat pad:hold(range=[50,67]) prog=ending dyn=mf>p

mix pad -4 sc=.7 hall=.25 | arp -4 sc=.3 hall=.15 | lead 17 hall=.25 | bass -2 sc=.5 | bell -12 hall=.4 | drums -3 | fx -6
inserts arp delay(time=0.75, feedback=.35, mix=.22) | lead delay(time=0.75, feedback=.3, mix=.12)
master standard lufs=-14 glue=none
