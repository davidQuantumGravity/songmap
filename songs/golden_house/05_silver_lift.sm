# 5. Silver Lift. Golden House, song 5 of 5 (textbook Chapter 49). Melodic progressive house, 128 BPM: a saw lead,
# a pluck arpeggio, a sidechained pad, a rolling bass, a piano in the breakdown.
# Golden techniques: golden giant steps and the pivot between layers (Chapters 37 and 35). The build walks
# Coltrane's major-third cycle C - Ab - E - C, each step through its golden passing chord, while the lead holds the
# step's common tone: C, then Ab, then E, then C. Then the dance-music key change, done the golden way: instead of
# rising a semitone or a tone for the last drop, the song rises a silver third (10 sixth-steps, 333 cents) to ^Eb
# major, a key with no note in common with C. It pivots through Fg, golden IV in C and golden ii in ^Eb:
# F - Fg - ^Fm - ^Bb7 - ^Eb, the lead holding F, then ^F, then the new key's leading tone ^D.
# Form (74 bars): intro 8, drop_1 16, breakdown 16, giant 6, pivot 4, drop_2 16, outro 8.
song "Silver Lift" 128 4/4 C fps=30 seed=65 tail=4 tuning=36edo mood=techno
inst lead(voices=3, detune=3, vib_depth=3, cutoff=4200, release=.2) arp=pluck/v0(cutoff=2800, decay=.3) pad(voices=3, detune=3, drift=0, cutoff=2000, attack=.1, release=.6) keys=keys/still(hardness=.35) bass=bass/v0(cutoff=650, drive=2, env_amt=2, env_decay=.1, sub=.5) bell=clean/glass
kit kick=kick/v0(tune=49, sweep=30, decay=.48, click=.3, drive=2) clap=clap/v0 hat=hat/v0 ohat=hat/v0_open snare=snare/v0(tone=200, snap=.5, noise_decay=.25)

prog anthem  "C:1 G:1 Am:1 F:1"
prog slow    "Am:2 F:2 C:2 G:2"
prog giant   "C:1 ~:0.5 Ab:1 ~:0.5 E:1 ~:0.5 C:1.5"
prog pivot   "F:0.5 Fg:0.5 ^Fm:1 ^Bb7:2"
prog anthem2 "^Eb:1 ^Bb:1 ^Cm:1 ^Ab:1"
prog close   "^Eb:1 ^Bb:1 ^Cm:1 ^Ab:1 ^Eb:4"

# the theme (deg: in C for drop_1, re-keyed to ^Eb by key=^Eb in drop_2)
theme = {deg: "=mf 4/8^ 7/8 4/8 2/8 4/4 7/4 | 6/8^ 4/8 1/8 4/8 6/4 8/4 | 5/8^ 7/8 5/8 2/8 4/4 7/4 | 5/8^ 7/8 5/8 3/8 5/4 r/4"}
piano = {deg: "=mp 5/2 7/2 | 5/1 | 3/2 5/2 | 5/1 | 4/2 7/2 | 4/1 | 6/2 4/2 | 1/1"}
# giant steps: each step's common tone, C - Ab - E - C
steps = {deg: "=f 7/1 | 7/2 b5/2 | b5/1 | 2/1 | 2/2 0/2 | 0/1"}
# the pivot: F (in F and Fg), ^F (in ^Fm), then ^D, the leading tone of ^Eb
turn = {deg: "=mf 3/1 | ^3/1 | ^1/1 | ^3/2 ^1/2"}
offbeat = {rel: "r/8 R/8^ r/8 R/8 r/8 R/8^ r/8 R/8", oct: -2}
rolling = {rel: "r/16 R/16^ R/16 R/16 r/16 R/16 R/16 R/16 r/16 R/16^ R/16 R/16 r/16 R/16 R/16 R/16", oct: -2}
bell_line = {deg: "=p r/2 7/2 | r/1 | r/2 7/2 | r/1", oct: 1}
bell_slow = {deg: "=p r/2 7/2 | r/1 | r/2 7/2 | r/1 | r/2 7/2 | r/1 | r/2 6/2 | r/1", oct: 1}

floor = {kick: "X...X...X...X...", hat: {steps: "..x...x...x...x.", vel: [0.42, 0.34, 0.45, 0.32]}}
main = floor with {hat: {steps: "..x...x...x...x.|..x...x...x...x.|..x...x...x...x.|..x...x...x.x.xx", vel: [0.42, 0.34, 0.45, 0.32]}} + {clap: "....X.......X..."}
peak_beat = main with {ohat: {steps: "..x...x...x...x.|..x...x...x...x.|..x...x...x...x.|..x...x.x.x.xxxx", vel: [0.48, 0.4]}, hat: {steps: "xxXxxxXxxxXxxxXx", vel: [0.3, 0.18, 0.4, 0.18]}}
roll = {snare: {steps: "x...x...x...x...|x...x...x...x...|x.x.x.x.x.x.x.x.|x.x.x.x.x.x.x.x.|xxxxxxxxxxxxxxxx|xxxxxxxxxxxxxxxx", vel: [0.25, 0.3, 0.36, 0.42, 0.5, 0.58]}}

intro      8 | drums:floor pad:hold(range=[50,67]) arp:up prog=anthem dyn=p<mp
drop_1    16 | drums:main(gain_db=-2.5) bass:offbeat pad:hold(range=[50,67]) arp:up lead:theme prog=anthem dyn=mp<mf | !impact(size=m)
breakdown 16 | pad:hold(range=[50,67]) keys:piano bell:bell_slow prog=slow dyn=p<mp
giant      6 | drums:floor+roll bass:offbeat pad:hold(range=[50,67]) arp:up lead:steps prog=giant dyn=p<mp
pivot      4 | pad:hold(range=[50,67]) bass:{rel: "R/1", oct: -2} lead:turn prog=pivot dyn=p<mp | !riser:4@+4
drop_2    16 | drums:peak_beat bass:rolling pad:hold(range=[50,67]) arp:up lead:theme bell:bell_line prog=anthem2 key=^Eb dyn=f | !impact(size=xl)
outro      8 | drums:main(gain_db=-2) bass:offbeat pad:hold(range=[50,67]) arp:up prog=close key=^Eb dyn=mf>p

mix lead 12 hall=.25 | arp -4 sc=.3 hall=.15 | pad -4 sc=.7 hall=.25 | keys -2 hall=.3 | bass -2 sc=.5 | bell -12 hall=.4 | drums -3 | fx -6
inserts arp delay(time=0.75, feedback=.35, mix=.22) | lead delay(time=0.75, feedback=.3, mix=.12)
master standard lufs=-14 glue=none
