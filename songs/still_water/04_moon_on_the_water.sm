# 4. Moon on the Water. Still Water, song 4 of 5 (textbook Chapter 48). The centre of the suite and the sound of
# the bliss conjecture (ch41 §4): golden at every scale. 48 BPM, no drums. The harmony turns from ^Fg to the
# golden tonic Ag; the suite's theme is sung whole in gold at last (a soft lead, glass doubling), then in a
# three-voice canon over a held golden seventh Ag7, voiced close on a low organ so its partials beat at golden
# rates in the air (near 6, 7.5, 9.5 and 12 Hz from the A2 root). A choir blooms on ^Fg7, and the music
# settles on Ag.
# Hidden layer (headphones): the golden beat ladder of ch41 exactly, 10, 6.18 and 3.82 Hz (alpha, theta and the
# delta edge, each the difference of the two above), on A3 and the golden triad's other tones A4/phi (271.93 Hz,
# vC#4) and A5/phi^2 (336.13 Hz, ^E4). The ladder rises into place in `moonrise` from song 3's 6.18 / 3.82 / 2.36.
# The bells keep song 3's Fibonacci-word rhythm. Breath: two-bar phrases of 10 s (6 a minute).
# Form (42 bars): moonrise 8, light 13, coherence 8, bloom 5, afterglow 8.
song "Moon on the Water" 48 4/4 "A golden7" fps=30 seed=51 tail=8 tuning=36edo mood=ambient
inst gold=clean/golden_pad(release=2.5) bell=clean/glass voice=clean/glass(decay=6, damp=.6) lead=clean/lead choir=clean/organ(partials=6, rolloff=1.9, attack=.7, release=1.8) bliss=clean/organ(partials=8, rolloff=1.3, attack=1.2, release=2.2) host=clean/golden_pad(release=3)
binaural A3 A3*phi A4*phi^-1 beat=6.18 ladder=golden level=-12 fade=8 glide=8 breathe=2 breath=3

prog moonrise  "^Fg:3 ^Fg7:2 Ag:3"
prog light     "Ag:1 Ag7:1 vDg:1 ^Fg:1 Ag:1 ^Fg:1 Ag:1 Ag:1 ^Fg7:2 Ag7:3"
prog afterglow "Ag:3 ^Fg:2 Ag:3"

# key A golden7: 0 A, 1 A#, 2 vC#, 3 vD, 4 ^E, 5 ^F, 6 G#, 7 A. The suite's theme, projected into gold.
gq = "=p 2/4 4 7/2 | 6/4. 4/8 2/2 | 3/4 2 0/2 | 2/2. r/4"
ga = "2/4 4 7/2 | 9/4. 7/8 5/2 | 4/4 3 2/2 | 0/1"
song_line = {deg: gq + " | " + ga + " | =mp 7/1 | 5/2 4/2 | 6/1 | 4/2 2/2 | 0/1"}
shimmer = {deg: "=pp r/1 | r/1 | r/1 | r/1 | " + ga + " | r/1 | r/1 | r/1 | r/1 | r/1", oct: 1}
# the canon over Ag7 (8 bars) and ^Fg7 (5): three entries of the theme, every note a tone of the held chord
canon_a = {deg: "=mp 2/4 4 7/2 | 6/4. 4/8 2/2 | 4/4 2 0/2 | 2/2. r/4 | 2/4 4 7/2 | 9/4. 7/8 6/2 | 4/4 3 2/2 | 0/1"}
canon_b = {deg: "=p r/1 | r/1 | r/1 | 2/4 4 7/2 | 6/4. 4/8 2/2 | 4/4 2 0/2 | 2/2. r/4 | 2/4 4 7/2", oct: 1}
canon_c = {deg: "=p 2/2 4/2 | 7/1 | 6/2. 4/4 | 2/1 | r/1 | r/1 | r/1 | r/1", oct: -1}
bloom_a = {deg: "=mf 7/2 9/2 | 9/1 | 7/2 5/2 | 4/1 | 7/1"}
bloom_b = {deg: "=mp 9/4. 7/8 5/2 | 4/4 2 0/2 | 2/1 | 0/1 | r/1", oct: 1}
bloom_c = {deg: "=p 5/1 | 7/1 | 4/1 | 2/1 | 0/1", oct: -1}
glow = {deg: "=p 2/2 4/2 | 7/1 | r/1 | 5/1 | r/1 | 4/2 2/2 | 0/1 | r/1"}
# the bliss chord: Ag7 in close voicing on A2 (A2 vC#3 ^E3 G#3), a harmonic tone, held
bliss = {notes: "=p [a--,vc#-,^e-,g#-]1 | [a--,vc#-,^e-,g#-]1@46"}
drops = {rel: "=pp 5/2. 3+/2 R+/2. 5+/2. 3+/2 5/2. 3+/2 R+/2. 5+/2. 3+/2 5/2. 3+/2. R+/2 5+/2. 3+/2 5/2. 3+/2. R+/2 5+/2. 3+/2 5/2.", oct: 1}
host = {notes: "=pp a-1 | =p a-1"}
golden_host = {notes: "=pp [a-,vc#,^e]1 | =p [a-,vc#,^e]1"}

moonrise   8 | gold:hold bell:drops host:host prog=moonrise dyn=pp<p beat=6.18>10
light     13 | gold:hold lead:song_line voice:shimmer bell:drops host:golden_host prog=light dyn=p<mp binaural={carriers: [A3, "A4*phi^-1", "A5*phi^-2"], beat: 10}
coherence  8 | gold:hold lead:canon_a bell:canon_b voice:canon_c bliss:bliss host:golden_host chords="Ag7:8" dyn=p<mp
bloom      5 | gold:hold choir:hold(range=[60,81]) lead:bloom_a bell:bloom_b voice:bloom_c host:golden_host chords="^Fg7:5" dyn=mp<mf
afterglow  8 | gold:hold lead:glow bell:drops host:golden_host prog=afterglow dyn=mp>pp

mix gold -9 hall=.35 | lead -2 hall=.35 | bell -12 hall=.5 pan=.2 | voice -6 hall=.4 pan=-.15 | choir -20 hall=.4 | bliss -17 hall=.2 | host -14 hall=.2
master standard lufs=-23 glue=none
