# 5. First Light. Still Water, song 5 of 5 (textbook Chapter 48). The return. 48 quickening to 56 BPM, no drums.
# Before dawn the golden home holds (Ag); at dawn the golden triad opens into A major, its third and fifth each
# rising a sixth-step (vC# to C#, ^E to E): Western consonance, the deepest release, after four songs of gold.
# Piano, strings, harp and choir carry the suite's theme in A major, now complete and at its fullest, and the
# glass bell closes the suite with the theme's first three notes, as it opened song 1.
# Hidden layer (headphones): the golden ladder's top rungs, 10 and 6.18 Hz, at first on Ag's tones (A3, vC#4,
# ^E4). In `dawn` the golden pairs fade while the golden chord still sounds, leaving A3 alone for a bar; E4
# returns with A major. In `awake` the beat climbs back to 16.18 Hz, where song 1 began: the ladder descended
# and climbed again, ending in ordinary alertness.
# Breath: two-bar phrases, 10 s quickening to 8.6 s.
# Form (38 bars): before_dawn 8, dawn 1, sunrise 13, morning 8, awake 8.
song "First Light" 48 4/4 A fps=30 seed=52 tail=8 tuning=36edo mood=ambient
inst mel=keys/still(hardness=.3) keys=keys/still(hardness=.25) harp=string_pluck/still(brightness=.7, t60=2.4, body=.6) strings=pad/still low=clean/bass bell=clean/glass flute=clean/lead choir=clean/organ(partials=6, rolloff=1.9, attack=.7, release=1.8) gold=clean/golden_pad(release=2.5) host=clean/organ(partials=4, rolloff=2.2, attack=1.4, release=2.6) ghost=clean/golden_pad(release=3)
binaural A3 A4*phi^-1 A5*phi^-2 beat=10 ladder=golden level=-12 fade=8 glide=3 breathe=2 breath=3

prog before "Ag:3 ^Fg:2 Ag:3"
prog sunrise "A:2 F#m:2 D:2 E:1 A:2 C#m:1 Bm7:1 E:1 A:1"
prog theme "A:1 C#m:1 Bm7:1 F#m:1 A:1 E:0.5 D:0.5 E7:1 A:1"
prog awake "A:2 D/A:2 Bm7/A:2 A:2"

# golden (key A golden7) before dawn; A major from `sunrise` on
glow = {deg: "=p 2/2 4/2 | 7/1 | r/1 | 5/1 | r/1 | 4/2 2/2 | 0/1 | r/1"}
drops = {rel: "=pp 5/2. 3+/2 R+/2. 5+/2. 3+/2 5/2. 3+/2 R+/2. 5+/2. 3+/2 5/2. 3+/2. R+/2 5+/2. 3+/2 5/2. 3+/2. R+/2 5+/2. 3+/2 5/2.", oct: 1}
rise = {deg: "=mp 2/4 4 7/2 | 7/1 | 5/4. 4/8 2/2 | 0/1 | 3/4 5 7/2 | 5/1 | 4/2. 6/4 | 7/2. 9/4 | 7/1 | 6/2 4/2 | 3/2 1/2 | 1/2. 4/4 | 2/1"}
full_tune = {deg: "=mf 2/4 4 7/2 | 6/4. 4/8 2/2 | 3/4 2 1/2 | 2/2. r/4 | =f 2/4 4 7/2 | 8/4. 7/8 6/2 | 5/4 4 1/2 | 0/1"}
descant = {deg: "=mp 2/4 4 7/2 | 6/4. 4/8 2/2 | 3/4 2 1/2 | 2/2. r/4 | 2/4 4 7/2 | 8/4. 7/8 6/2 | 5/4 4 1/2 | 0/1", oct: 1}
coda = {deg: "=p 2/2 4/2 | 7/1 | 5/2. 3/4 | 0/1 | 1/1 | 3/2 1/2 | 2/2 0/2 | 0/1"}
head = {deg: "=p r/1 | r/1 | r/1 | r/1 | 2/4 4 7/2 | r/1 | 2/4 4 7/2 | r/1", oct: 1}
ripple = {rel: "R/8^ 5 R+ 3+ 5+ 3+ R+ 5"}
slow_ripple = {rel: "R/4^ 5 R+ 3+"}
golden_host = {notes: "=pp [a-,vc#,^e]1 | =p [a-,vc#,^e]1"}
host = {notes: "=pp [a-,e]1 | =p [a-,e]1"}

before_dawn 8 | gold:hold bell:drops mel:glow ghost:golden_host prog=before key="A golden7" dyn=p
dawn        1 | gold:hold ghost:{notes: "=pp a-1"} chords="Ag:1" key="A golden7" dyn=p binaural={carriers: [A3]}
sunrise    13 | mel:rise keys:hold strings:hold choir:hold(range=[60,81]) low:bassline host:host prog=sunrise dyn=mp tempo="accel 48>54" binaural={carriers: [A3, E4]}
morning     8 | mel:full_tune flute:descant harp:ripple strings:hold low:bassline host:host prog=theme dyn=mf<f tempo=54
awake       8 | mel:coda harp:slow_ripple strings:hold low:bassline bell:head host:host prog=awake dyn=mp>p tempo="accel 54>56" beat=10>16.18

mix mel 3 hall=.3 | keys -9 hall=.25 | harp -8 hall=.3 pan=.2 | strings -22 hall=.35 | low -7 hall=.1 | bell -12 hall=.45 pan=-.15 | flute -6 hall=.35 pan=-.1 | choir -22 hall=.4 | gold -9 hall=.35 | host -16 hall=.15 | ghost -14 hall=.2
master standard lufs=-23 glue=none
