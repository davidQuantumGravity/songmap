# SFZ edition of songs/still_water/02_the_slow_tide.sm. Original score and renders preserved.
# Instrumentation and faders revised; written notes, tuning, form, timing and binaural settings retained.
# Listening candidate: automated measurements are not a human listening verdict.
# 2. The Slow Tide. Still Water, song 2 of 5 (textbook Chapter 48). From A major into golden water, 54 slowing to
# 48 BPM, no drums. The theme returns at half speed, as a tide; then the harmony turns golden through the one note
# that never moves: D becomes vDg (D sinks a sixth-step, F# two, A stays), and the music settles into the golden
# chords that share A: vDg and ^Fg, on a golden-spectrum pad and glass bells.
# Hidden layer (headphones): the A3 pair continues from song 1. The second pair is E4 while the harmony is
# Western, and crossfades to A3*phi (355.97 Hz, ^F4, the chain's next tone) when it turns golden, so the
# carriers are always chord tones. Beats: 10 and 6.18 Hz slowing to 6.18 and 3.82 (alpha into theta).
# Breath: two-bar phrases, 8.9 s growing to 10 s; the layer swells once per phrase.
# Form (47 bars): drift 5, tide 8, ebb 8, turning 5, undertow 13, slack_water 8.
song "The Slow Tide" 54 4/4 A fps=30 seed=49 tail=6 tuning=36edo mood=ambient
inst mel=sampler/grand_piano keys=sampler/grand_piano harp=sampler/folk_harp strings=pad/still low=clean/bass bell=clean/glass gold=clean/golden_pad(release=2) gong=clean/glass(decay=9, damp=.4) host=clean/organ(partials=4, rolloff=2.2, attack=1.4, release=2.6)
binaural A3 E4 beat=10 ladder=golden level=-12 fade=8 glide=6 breathe=2 breath=3

prog drift   "A:2 F#m:2 D:1"
prog tide    "A:2 C#m:2 Bm7:2 F#m:2"
prog ebb     "A:2 E:1 D:1 E7:2 A:2"
prog turning "F#m:1 Bm7:1 D:2 D:1"
prog under   "vDg:2 ^Fg:2 vDg7:2 ^Fg:1 vDg:2 ^Fg7:2 vDg:2"
prog slack   "vDg:3 ^Fg:2 vDg:3"

# the suite's theme (song 1), here at half speed: the question in `tide`, the answer in `ebb`
q = "=p 2/4 4 7/2 | 6/4. 4/8 2/2 | 3/4 2 1/2 | 2/2. r/4"
a = "=p 2/4 4 7/2 | 8/4. 7/8 6/2 | 5/4 4 1/2 | 0/1"
turn_tune = {deg: "=p 2/2. 1/4 | 0/2 3/2 | 5/1 | 7/1 | 7/1", oct: 0}
# golden water (key A golden7: A A# vC# vD ^E ^F G#): bells on chord tones, theme fragments projected into gold
under_bell = {deg: "=p r/1 | 5/2 7/2 | r/1 | r/2 2/4 0 | r/1 | 3/2. 5/4 | r/1 | 5/1 | r/1 | 2/2 0/2 | r/1 | 3/2 5/2 | 7/1", oct: 1}
slack_bell = {deg: "=pp r/1 | 7/2. 5/4 | r/1 | 5/1 | r/1 | 3/2 0/2 | r/1 | 0/1", oct: 1}
slow_ripple = {rel: "R/4^ 5 R+ 3+"}
gong = {rel: "R/1 | r/1", oct: -1}
host = {notes: "=pp [a-,e]1"}
golden_host = {notes: "=pp a-1"}

drift        5 | keys:hold strings:hold harp:slow_ripple host:host prog=drift dyn=p
tide         8 | mel:{deg: q}:aug keys:hold harp:slow_ripple strings:hold low:bassline host:host prog=tide dyn=p<mp beat=10>8.6
ebb          8 | mel:{deg: a}:aug harp:slow_ripple strings:hold low:bassline host:host prog=ebb dyn=mp>p beat=8.6>7.6
turning      5 | mel:turn_tune strings:hold low:bassline host:host prog=turning dyn=p tempo="rit 54>48" beat=7.6>7.1
undertow    13 | gold:hold bell:under_bell gong:gong host:golden_host prog=under key="A golden7" dyn=p tempo=48 binaural={carriers: [A3, "A3*phi"], beat: "7.1>6.18"}
slack_water  8 | gold:hold bell:slack_bell gong:gong host:golden_host prog=slack key="A golden7" dyn=p>pp beat=6.18

mix mel 13.3 hall=.3 | keys 4.8 hall=.25 | harp 3 hall=.3 pan=.2 | strings -22 hall=.35 | low -7 hall=.1 | bell -9 hall=.45 pan=-.15 | gold -10 hall=.35 | gong -8 hall=.4 | host -16 hall=.15
master standard lufs=-23 glue=none
