pump_beat_d = {kick: "XxXxXxXxXxXxXxXx", snare: {steps: "x.x.x.x.x.x.x.x.|xxxxxxxxxxxxxxxx", vel: [0.3, 0.34, 0.38, 0.42, 0.46, 0.5, 0.55, 0.6, 0.64, 0.68, 0.72, 0.76, 0.8, 0.84, 0.9, 1.0]}, tom1: "................|........x.x.x.x."}
summit_beat = riff_beat with {cym: "X.............|X.............|X.............|X.............", ride: {steps: "x.x.x.x.x.x.x.", vel: [0.5, 0.3, 0.45, 0.3, 0.5, 0.35, 0.3]}, hat: none}
peak_beat = {kick: "XxXxXxXxXxXxXxXx", snare: "....X.......X...|....X.......X.XX", ride: {steps: "x.x.x.x.x.x.x.x.", vel: [0.6, 0.35, 0.5, 0.35]}, cym: "X.......X.......|X..............."}

# name           bars | parts and settings                                                                 | events
# ======== I. The door (C golden7 -> C phrygian dominant / F minor; metal) ========
veil             12 | gold:hold gtr:ripple bell:{deg: "=p r/1 | r/1 | 4/4. 5/8 4/4 2/4 | 0/1 | r/1 | 2/4. 4/8 0/2 | 6/2 4/2 | 4/1 | r/1 | 4/4. 5/8 7/4 6/8 5/8 | 4/1 | r/1", oct: 1} low:{notes: pedal_c, oct: -2} prog=veil_p key="C golden7" tempo=72 dyn=p<mp
door              2 | gold:hold gtr:ripple bell:{deg: "=mp 0/1 | 0/1", oct: 1} low:{notes: pedal_c, oct: -2} prog=door_p tempo=72 dyn=mp | !riser:2@+2
riff_1            8 | axe:riff bass:riff_bass drums:riff_beat chords="C:1" key="C phrygian_dominant" meter="7/8 2+2+3" dyn=f | !impact
riff_2            8 | like=riff_1 drums:riff_beat2 lead:riff_counter dyn=f
verse_1          16 | axe:chug bass:eighths drums:verse_beat lead:verse_tune prog=verse_p key="F harmonic_minor" meter=4/4 dyn=mp<mf
pre_1             4 | axe:power5 bass:bass5 drums:pre_beat lead:pre_tune organ:hold prog=pre_p key=Ab meter="5/4 3+2" dyn=mp<f
chorus_1          8 | axe:power:gain_db=-3 bass:eighths drums:chorus_beat:gain_db=-2 lead:chorus_tune prog=chorus_p key=Ab meter=4/4 dyn=mp<mf | !impact(size=m)
riff_3            4 | axe:riff bass:riff_bass drums:riff_beat chords="C:1" key="C phrygian_dominant" meter="7/8 2+2+3" dyn=f
verse_2           8 | axe:chug bass:eighths drums:verse_beat2:gain_db=-2 lead:verse_tune organ:hold(range=[48,67]) prog=verse_p key="F harmonic_minor" meter=4/4 dyn=mf
pre_2             4 | like=pre_1 dyn=mf<f
chorus_2          8 | axe:power:gain_db=-3 bass:eighths drums:chorus_beat2:gain_db=-2 lead:chorus2_tune organ:hold bell:{deg: "=p < " + phi_a + " =mf | " + phi_b2, oct: 1} prog=chorus2_p key=Ab meter=4/4 dyn=mp<mf | !impact(size=m)
riff_out          4 | axe:riff bass:riff_bass drums:riff_beat2 chords="C:1" key="C phrygian_dominant" meter="7/8 2+2+3" dyn=f>mf | !stop:2b@+3:2.5
# ======== II. Blue gold (modal jazz, swung; C dorian -> golden modes -> C major) ========
head_dorian       8 | horn:head bass:walk epiano:comp(rhythm="x.....x...x.....", voices=4, range=[52,70]) drums:swing_beat prog=dorian_p key="C dorian" tempo=168 swing=.66 dyn=mp
head_golden       8 | like=head_dorian prog=goldor_p key="C golden7" dyn=mp<mf
head_lift         8 | like=head_dorian prog=lift_p key="^C golden7" dyn=mf
head_home         8 | like=head_dorian drums:swing_fill dyn=mf>mp
mode_60           8 | horn:door_ask axe:door_answer bass:walk epiano:comp(rhythm="x.....x...x.....", voices=4, range=[52,70]) drums:swing_beat prog=m60 key="C golden7_60" tempo=168 swing=.66 dyn=mf
mode_51           8 | like=mode_60 prog=m51 key="C golden7_51"
mode_42           8 | like=mode_60 prog=m42 key="C golden7_42"
mode_33           8 | like=mode_60 prog=m33 key="C golden7_33" drums:swing_fill
mode_24           8 | like=mode_60 prog=m24 key="C golden7_24"
mode_15           8 | like=mode_60 prog=m15 key="C golden7_15" dyn=mf>mp
mode_06           8 | like=mode_60 prog=m06 key="C golden7_06" drums:swing_fill dyn=mp
cadence           4 | horn:cadence_horn bass:walk epiano:hold(voices=4, range=[52,70]) drums:swing_beat prog=cadence_p tempo=168 swing=.66 dyn=mp<mf
giant             8 | horn:giant_horn bass:walk epiano:hold(voices=3, range=[52,72]) drums:swing_fill prog=giant_p key=C tempo=168 swing=.66 dyn=mf<f | !stop:2b@+7:3
# ======== III. Decatonic (7/8, 13/16; the golden circle) ========
deca_1            8 | axe:deca_riff bass:bass7 organ:hold(range=[52,70]) drums:deca_beat prog=circle_p key="C golden10_36" meter="7/8 2+2+3" dyn=mf | !impact
deca_2            8 | like=deca_1 lead:deca_lead drums:deca_beat:gain_db=-2 dyn=mf<f
planing           8 | axe:{notes: planed, oct: -1} bass:{notes: planed_roots, oct: -2} drums:plane_beat chords="N.C.:8" meter="7/8 2+2+3" dyn=mf
deca_13           8 | axe:riff13 bass:bass13 organ:hold(range=[52,70]) drums:beat13 prog=thirteen_p key="C golden10_36" meter="13/16 3+3+3+2+2" dyn=f
axe_solo         16 | axe:axe_solo_line bass:bass7 organ:hold(range=[52,70]) drums:deca_beat:gain_db=-2 prog=solo_p key="C golden10_36" meter="7/8 2+2+3" dyn=f | !riser:2@+16
still            16 | keys:still_keys bell:still_bell gold:hold gtr:ripple low:{rel: "=p R/1", oct: -2} drums:still_beat prog=still_p key="C golden7" tempo=69 meter=4/4 dyn=p<mp | !impact(size=s)
# ======== IV. Thirteen steps (the comma pump) and the summit, a comma higher ========
pump_a            6 | gold:hold lead="=mp ^g1 | ^g1 | ^ab1 | ^ab1 | ^ab1 | ^ab1" axe:{rel: "=mp [R,5,R+]/1", oct: -1} bass:{rel: "R/2^ R/2", oct: -2} drums:pump_beat_a prog=pump_ap tempo=138 dyn=mp
pump_b            8 | gold:hold lead="=mf ^ab1 | ^ab1 | ^a1 | ^a1 | ^a1 | ^a1 | ^a1 | ^a1" axe:power:gain_db=-3 bass:eighths drums:pump_beat_b:gain_db=-3 prog=pump_bp dyn=mp<mf
pump_c            6 | organ:hold(range=[48,66]) lead="=f ^bb1 | ^bb1 | ^bb1 | ^b1 | ^b1 | ^b1" bell="=f ^bb+1 | ^bb+1 | ^bb+1 | ^b+1 | ^b+1 | ^b+1" axe:chug:gain_db=-3 bass:eighths drums:pump_beat_c:gain_db=-3 prog=pump_cp dyn=f | !riser:4@+8
pump_d            2 | organ:hold(range=[48,66]) lead="=f ^c+1 | ^c+1" bell="=f ^c++1 | ^c++1" axe:{rel: "=f [R,5,R+]/16 [R,5,R+] [R,5,R+] [R,5,R+] [R,5,R+] [R,5,R+] [R,5,R+] [R,5,R+] [R,5,R+] [R,5,R+] [R,5,R+] [R,5,R+] [R,5,R+] [R,5,R+] [R,5,R+] [R,5,R+]", oct: -1, gain_db: -4} bass:eighths drums:pump_beat_d:gain_db=-7 chords="^Cg:2" dyn=mf<f
summit_riff       8 | axe:riff bass:riff_bass lead:riff_counter drums:summit_beat chords="^C:1" key="^C phrygian_dominant" meter="7/8 2+2+3" dyn=f | !drop:1@-1(keep=[organ, lead, bell, fx]) !impact(size=xl)
summit_verse      8 | axe:chug bass:eighths drums:verse_beat2:gain_db=-2 lead:verse_tune organ:hold(range=[48,67]) prog=verse3_p key="^F harmonic_minor" meter=4/4 dyn=mp<mf
summit_pre        4 | axe:power5 bass:bass5 drums:pre_beat lead:pre_tune organ:hold prog=pre3_p key=^Ab meter="5/4 3+2" dyn=mf<f
summit_chorus     8 | axe:power:gain_db=-3 bass:eighths drums:chorus_beat2:gain_db=-2 lead:chorus_tune prog=chorus3_p key=^Ab meter=4/4 dyn=mf | !impact(size=m)
last_chorus       8 | axe:power:gain_db=2 bass:eighths drums:peak_beat:gain_db=1 lead:chorus2_tune horn:{deg: "=f " + phi_a + " | " + phi_b2, oct: -1} bell:{deg: "=mf < " + phi_a + " =f | " + phi_b2, oct: 1} prog=chorus4_p key=^Ab dyn=f | !drop:1@-1(keep=[lead, fx]) !impact
coda             12 | gold:hold gtr:ripple keys:coda_tune bell:{deg: "=p r/1 | r/1 | r/1 | r/1 | r/1 | r/1 | r/1 | r/1 | 7/1 | 7/1 | 7/1 | 7/1", oct: 2} low:{rel: "=p R/1", oct: -2} prog=coda_p key="^C golden7" tempo=72 dyn=mp>pp

mix axe -6 hall=.08 | bass -8 | lead 13 hall=.2 | horn -7 hall=.25 | epiano 0 hall=.2 | keys 9 hall=.3 | organ -16 hall=.2 | gold -9 hall=.35 | bell -8 hall=.4 pan=.15 | gtr -3 hall=.3 pan=-.2 | low 0 | drums -4 | fx -6
