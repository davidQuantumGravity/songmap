prog m06 "Csus2(vvvv5):3 vFg:1 Csus2(vvvv5):3 Dg7:1"
prog cadence_p "vGg/D:1 G7:1 Baug(v3)/G:0.5 ^Ebg(^5)/G:0.5 Cmaj7:1"
prog giant_p   "Cmaj7:1 C:1 Cg:0.5 Ab:1 Abg:0.5 E:1 Eg:0.5 C:2.5"
prog circle_p  "Cg:1 ^Abg:1 vFg:1 C#g:1 ^Ag:1 vF#g:1 Dg:1 Dg7:1"
prog thirteen_p "vEg:2 Cg:2 C#g:2 Cg:2"
prog solo_p    "Cg:1 ^Abg:1 vFg:1 C#g:1 ^Ag:1 vF#g:1 Dg:2 vF#g:1 ^Ag:1 C#g:1 vFg:1 ^Abg:1 Cg:1 C#g:1 Cg:1"
prog still_p   "Cg:2 ^Abg7:1 Cg:1 ^Abg:1 Cg:0.5 C#g:0.5 ^Abg7:1 Cg:1 vEg:1 Cg:1 ^Abg:1 vFg:1 C#g:1 C#g7:1 Bg:1 Cg:1"
prog pump_ap   "Cg:2 ^Abg:2 vFg:2"
prog pump_bp   "C#g:2 ^Ag:2 vF#g:2 Dg:2"
prog pump_cp   "^Bbg:1 vGg:1 Ebg:1 ^Bg:1 vAbg:1 Eg:1"
prog verse3_p   "^Fm:1 ^Db:1 ^C:1 ^Fm:1 ^Fm:1 ^Db:1 ^Bbm:1 ^C:1"
prog pre3_p     "^Db:1 ^Eb:1 ^Fm:1 ^Eb:1"
prog chorus3_p "^Ab:1 ^Fm:1 ^Db:1 ^Eb:1 ^Db:1 ^Eb:1 ^Fm:1 ^Ab:1"
prog chorus4_p "^Ab:1 ^Fm:1 ^Db:1 ^Eb:1 ^Db:1 ^Eb:0.5 Eg:0.25 ^Eg:0.25 ^Fm:1 ^Ab:1"
prog coda_p    "^Cg:2 vAg7:1 ^Cg:1 vAg:1 ^Cg:0.5 ^C#g:0.5 vAg7:1 ^Cg:1 ^Cm:1 ^Cm(^3):1 ^Cg:1 ^C:1"

# --- themes ----------------------------------------------------------------------------------------------
# phi: the song's tune, in scale degrees so every key and mode recolours it (Ab major in the chorus, C golden7
# in the ballad, ^C golden7 in the coda). phi_b2 rests where the golden deceptive chords pass.
phi_a = "4/4. 5/8 4/4 2/4 | 0/4. 1/8 2/2 | 4/4. 5/8 7/4 6/8 5/8 | 4/1"
phi_b = "5/4. 4/8 2/4 5/4 | 4/4. 2/8 1/2 | 2/4. 4/8 5/4 6/4 | 7/1"
phi_b2 = "5/4. 4/8 2/4 5/4 | 4/4. 2/8 r/2 | 2/4. 4/8 5/4 6/4 | 7/2. r/4"
chorus_tune = {deg: "=mf " + phi_a + " | =f " + phi_b, oct: 0}
chorus2_tune = {deg: "=f " + phi_a + " | =ff " + phi_b2, oct: 0}
# the riff: C phrygian dominant in 7/8 (2+2+3), accents on the group starts
riff = {deg: "=f 0/16^ 0 r 0 1/8^ 0/16 r 0 0 4/8^ 3/16 1 | 0/16^ 0 r 0 1/8^ 0/16 r -1 -2 -3/8^ -2/16 -1 | 0/16^ 0 r 0 1/8^ 0/16 r 0 0 4/8^ 5/16 4 | 7/8^ 6/16 5 4/8 3/16 1 0/8^ 0/16 r 0 r", oct: -2}
riff_bass = {deg: "=f 0/16^ 0 r 0 1/8^ 0/16 r 0 0 4/8^ 3/16 1 | 0/16^ 0 r 0 1/8^ 0/16 r -1 -2 -3/8^ -2/16 -1 | 0/16^ 0 r 0 1/8^ 0/16 r 0 0 4/8^ 5/16 4 | 7/8^ 6/16 5 4/8 3/16 1 0/8^ 0/16 r 0 r", oct: -2}
riff_counter = {deg: "=mp < 7/2.. | 9/2.. | 11/2..^ =f | 10/8 9/8 8/8 7/2", oct: 0}
# the verse (F harmonic minor): two eight-bar phrases
verse_tune = {deg: "=mp 4/4.^ 3/8 2/4 1/8 2/8 | 0/2 r/4 4/8 5/8 | 6/4. 5/8 4/4 2/4 | 4/2. r/4 | 4/4. 3/8 2/4 4/4 | 5/4. 4/8 3/2 | 3/4. 2/8 1/4 3/4 | 6/2. r/4 | =mf 4/4.^ 5/8 6/4 7/4 | 9/2^ r/4 7/8 6/8 | 6/4. 5/8 4/4 2/4 | 4/2. r/4 | 7/4. 6/8 7/4 4/4 | 5/4. 4/8 3/2 | 3/4. 4/8 5/4 4/4 | 6/2. r/4", oct: 0}
# pre-chorus (Ab major, 5/4 3+2): a climb to the chorus's first note
pre_tune = {deg: "=mp < 5/2. 3/2 | 4/2. 6/2 | 5/2. 7/2 | 8/2.^ 4/4 6/4 =f", oct: 0}
# the modal jazz head (8 bars, swung): the same degrees in C dorian, C golden7 and ^C golden7
head = {deg: "=mf r/8 0/8 2/8 4/8 6/4^ 4/8 2/8 | 0/4. r/8 r/2 | r/8 2/8 4/8 6/8 7/4^ 6/8 4/8 | 5/2. r/4 | r/8 7/8 6/8 4/8 5/8 4/8 2/8 1/8 | 2/2 r/2 | r/8 4/8 3/8 2/8 1/8 0/8 -1/8 1/8 | 0/2. r/4", oct: 1}
# trading fours through the seven modes: the horn asks, the guitar answers; both rest while the mode's colour
# chord sounds (bars 4 and 8)
door_ask = {deg: "=mf r/8 4/8 2/8 0/8 2/4^ 4/4 | 6/8 7/8 6/8 4/8 2/4. 0/8 | 1/8 2/8 4/8 2/8 0/2 | r/1 | r/1 | r/1 | r/1 | r/1", oct: 1}
door_answer = {deg: "=f r/1 | r/1 | r/1 | r/1 | 7/16^ 6 4 2 0/8 2/8 4/4 6/4 | 7/4.^ 6/8 4/2 | 2/8 4/8 6/8 7/8 9/4^ 7/4 | r/1", oct: 0}
cadence_horn = {rel: "=mf 5/1 | 7/2 5/2 | 3/2 3/2 | 7/1", oct: 1}
giant_horn = {deg: "=f 7/1 | 7/1 | 7/1 | b5/1 | b5/2 2/2 | 2/1 | 2/2 4/2 | 7/1", oct: 1}
# the decatonic riff: bar 1 in the even golden pentatonic (C D vF ^G ^A), bar 2 in the odd one (C# vE vF# ^Ab B)
deca_riff = {deg: "=f 0/16^ 0 2 0 4/8^ 2/16 0 6/8^ 4/16 2 8/8 | 1/16^ 1 3 1 5/8^ 3/16 1 7/8^ 5/16 3 9/8", oct: -1}
deca_lead = {deg: "=mp < 6/4.^ 7/8 6/4. | 7/4. 9/8 10/4. | 10/4 9/8 7/8 4/4. | 7/4. 4/8 1/4. | 8/4. 9/8 11/4. | 11/4. 12/8 15/4. | 15/4.^ 18/8 12/4. =f | 11/2..", oct: 0}
riff13 = {deg: "=f 0/16^ 2 4 1^ 3 5 2^ 4 6 3^ 5 4^ 2", oct: -1}
# golden planing: a C major line in the roots, vE major in the thirds, ^G major in the fifths
planed = "=mf < [c,ve,^g]4^ [d,vf#,^a]8 [e,vg#,^b]8 [g,vb,^d+]4. | [a,vc#+,^e+]4 [g,vb,^d+]8 [e,vg#,^b]8 [d,vf#,^a]4. | [e,vg#,^b]4 [g,vb,^d+]8 [a,vc#+,^e+]8 [c+,ve+,^g+]4. | [b,vd#+,^f#+]4 [a,vc#+,^e+]8 [g,vb,^d+]8 [e,vg#,^b]4. | [f,va,^c+]4 [e,vg#,^b]8 [d,vf#,^a]8 [c,ve,^g]4. | [d,vf#,^a]4 [e,vg#,^b]8 [f,va,^c+]8 [a,vc#+,^e+]4. | [g,vb,^d+]4 [f,va,^c+]8 [e,vg#,^b]8 [d,vf#,^a]4. =f | [c,ve,^g]2..^"
planed_roots = "=mf < c4^ d8 e8 g4. | a4 g8 e8 d4. | e4 g8 a8 c+4. | b4 a8 g8 e4. | f4 e8 d8 c4. | d4 e8 f8 a4. | g4 f8 e8 d4. =f | c2..^"
axe_solo_line = {deg: "=mf < 6/16^ 7 6 3 0 3 6 9 10/8 9/16 7 6/8 | 7/8 10/16 9 7 3 0 3 7/4. | 4/16 7 10 7 4 7 10 11 10/4. | 11/16 10 7 4 1 4 7 10 11/4. | 11/8 8/16 4 1 4 8 11 8/4. | 8/16 11 12 11 8 5 8 11 15/4. | 15/16 14 12 11 12 14 15 18 15/8 12/8 18/8 | 18/2..^ =f | > 18/16 17 15 14 15 12 11 8 11/4. | 8/16 11 14 11 8 4 1 4 8/4. | 7/8 4/8 1/8 4/16 7 11/4. | =mf < 10/16 7 4 7 10 11 10 7 4/4. | 7/8 10/8 7/8 3/16 0 3/4. | 6/16 9 10 9 6 3 6 9 10/4. | 11/8 10/16 7 4/8 1/8 4/8 7/8 11/8 =f | 10/2..^", oct: 0}
# the ballad: phi in C golden7, then a new strophe on the bell that leads into the pump's first note (^G)
still_keys = {deg: "=mp " + phi_a + " | " + phi_b + " | r/1 | r/1 | r/1 | r/1 | r/1 | r/1 | r/1 | r/1", oct: 1}
still_bell = {deg: "=p r/1 | r/1 | r/1 | r/1 | r/1 | r/1 | r/1 | r/1 | < 6/2 4/4 2/4 | 0/2. 2/4 | 5/4. 4/8 0/2 | 3/2 r/2 =mp | > 1/4. 3/8 5/2 | 7/2 5/2 | r/1 | =p r/2 4/2", oct: 1}
# the pump's top voice: each golden chord keeps two notes and raises one; this line is the voice that rises
# every third step, ^G ^Ab ^A ^Bb ^B ^C (written per section)
coda_tune = {deg: "=mp " + phi_a + " | " + phi_b + " | 7/1 | 7/1 | 7/1 | 7/1", oct: 1}

