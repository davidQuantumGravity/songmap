# Night Market (1:00, 30 fps, 1800 frames). Travel-vlog cue, D dorian -> D major, 120 BPM, mood=balanced.
# Intent: neon flickers on over an empty street, the crowd and the food stalls arrive (narration under it),
# a street musician plays a hook, rain brings everyone under awnings, then the rain stops and the hook
# comes back in major, an octave up, doubled and warmer: the emotional high point. Gentle end card.
# Listen for: (1) the 2-bar hook at f720 (rising D-F-A, leap to the high D, falling answer);
# (2) the same hook slowed to half speed and hushed in the rain; (3) at f1380 everything but the pad drops
# for one bar (the rain stops), then the hook returns in D major with a lead and piano doubling;
# (4) a quiet plagal D-Gmaj7-D close. Sizzle = very soft 16th hats under the market.
song "Night Market" 120 4/4 "D dorian" fps=30 seed=21 tail=2 mood=balanced video=NightMarket:1800
inst epiano(trem_depth=.35, index=.9) keys(hardness=.4, t60=7) gtr=string_pluck(brightness=.6) bass(cutoff=480)
chords Dm7 G7 Dm7 G7

# hook: deg 0 = D (D dorian; in the glow section key=D makes it D major).
hookA = "=mp 0/8 2 4/4 7/4. 6/8 | 5/4 4 2/4. 0/8"
hookB = "=mp 0/8 2 4/4 7/4. 6/8 | 5/4 4 2/4 4/8 5"
hookC = "=mf 6/4. 4/8 6/4 7 | 7/2. r/4"
hook   = {deg: hookA + " | " + hookB + " | " + hookC, oct: 1}
hook4  = {deg: hookA + " | " + hookC, oct: 1}
hookA1 = {deg: hookA, oct: 0}
hook4_low = {deg: hookA + " | " + hookC, oct: 0}
# the end card: a falling answer, then home
bye = {deg: "=p 5/2 2/2 | 0/1", oct: 1}

pocket = {kick: "X.....x...x.....", snare: "....X..o....X.o.", hat: {steps: "x.x.x.x.x.x.x.x.", vel: [0.55, 0.3, 0.45, 0.3, 0.55, 0.3, 0.45, 0.35]}}
sizzle = {hat16: {steps: "xxxxxxxxxxxxxxxx", vel: [0.22, 0.12, 0.18, 0.12]}}
stall  = {rim: "..x..x.x..x..x.x"}
light  = {kick: "X.......x.......", hat: {steps: "x.x.x.x.x.x.x.x.", vel: [0.45, 0.25, 0.35, 0.25]}}
walk   = {rel: "R/4.^ R/8 r/8 5/8 R+/4", oct: -2}
held   = {rel: "R/1", oct: -2}
comp   = {rel: "[3,7,9]/2 r/4 r/8t r [3,7,9]", oct: -1}
ripple = {rel: "R/8^ 5 R+ 3+ 5+ 3+ R+ 5"}
flick  = {deg: "=pp r/2 9/16 r/16 9/16 r/8 r/8. | r/1 | =p 11/16 r/16 11/16 r/16 9/8 r/2 r/8 | r/1", oct: 0}
spark  = !riser:1 !impact(size=s)

# name   bars | parts and settings                                                     | events
neon       4 | pad:dark arp:dark(order=[0,2,4,2]) gtr:flick dyn=pp<p                    | !zaps@+1(count=3, every=4)
crowd      8 | drums:pocket+sizzle+stall bass:walk epiano:comp gtr:ripple pad:warm dyn=p | !spark
busker     6 | drums:light bass:walk epiano:comp keys:hook pad:warm chords="Dm7:1 G7:1 Dm7:1 G7:1 Am7:1 Dm7:1" dyn=p<mp
rain       5 | pad:dark bass:held epiano:{rel: "[3,7,9]/1"} keys:hookA1:aug fx:ticks chords="Dm9:2 G7:2 Dm9:1" dyn=p>pp
glow       4 | drums:pocket+{ohat: "..x...x...x...x.", hat16: {steps: "xxxxxxxxxxxxxxxx", vel: [0.5, 0.2, 0.35, 0.2]}} bass:walk pad:warm gtr:ripple keys:hook4_low lead:hook4 chords="D:1 Gmaj7:1 A:1 D:1" key=D dyn=ff | !drop:1@-1(keep=[pad]) !riser:1 !impact(size=l)
endcard    2 | keys:bye pad:warm gtr:{rel: "[R,3,5]/2 [3,5,R+]/2"} chords="Gmaj7:1 D:1" key=D dyn=mp>pp

mix keys 1
mix lead 6
mix fx -9
