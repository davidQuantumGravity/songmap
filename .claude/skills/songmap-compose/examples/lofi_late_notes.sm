# Lo-fi "late notes" (1:40). Reflective, warm, a little lazy: 90 BPM (whole frames at 30 fps: 80 per bar).
# Shows: swing written on a 12-step (triplet) grid, ghosted snares, rootless 9th-chord voicings on the
# electric piano with an anticipated chord, a bass slide, a piano melody with a grace note and
# breathing rests, drums dropping out for a reflective bridge, and a ii-V-I-vi progression in D dorian.
song "Example: Late Notes" 90 4/4 "D dorian" fps=30 seed=7 tail=4
inst epiano(trem_depth=.35, index=.9) keys(hardness=.3, t60=8) bass(cutoff=480, glide=.08)
chords Dm9 G7 Cmaj9 Am7

lazy = {kick: "x.....x..x..|x.....x.....", snare: "...X.....X.o", hat: {steps: "x.xx.xx.xx.x", vel: [0.5, 0.25, 0.45, 0.22, 0.5, 0.25, 0.42, 0.3]}}
comp = {rel: "[3,7,9]/2 r/4 r/8t r [3,7,9]"}       # hold beat 1, push the next chord a triplet early
slide = {rel: "R/4. r/8 5/4~ R", oct: -2}            # ~ glides the 5th down into the root
# deg 0 = D. Phrases breathe: each 2-bar idea ends on a long note, then a rest.
tune = {deg: "=mp 4/8 {5}4 2/4 0/8 2 4/4 | 3/4. 2/8 0/2 | 2/8 4 5/4 4/8 2 0/4 | -1/2. r/4", oct: 1}

# name   bars | parts and settings                                  | events
dusk       4 | epiano:comp dyn=pp<p
walk       8 | like=dusk drums:lazy bass:slide dyn=p<mp
tune_a     8 | like=walk keys:tune dyn=mp
alone      4 | epiano:{rel: "[3,7,9]/1"} keys:tune chords="Fmaj7:2 Em7:1 Am7:1" dyn=p
tune_b     8 | like=tune_a dyn=mp<mf                                  | !impact(size=s)
fade       4 | epiano:comp keys:{deg: "0/1 | r/1 | -3/1 | 0/1", oct: 1} dyn=mp>pp
mix keys 2 | drums -3
